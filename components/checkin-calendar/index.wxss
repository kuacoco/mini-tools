.checkin-calendar {
  width: 100%;
  box-sizing: border-box;
}

.calendar-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 14rpx;
  padding: 25rpx 24rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(148deg, rgba(255, 255, 255, 0.98), rgba(247, 244, 255, 0.96));
  box-shadow: 0 18rpx 48rpx rgba(68, 55, 108, 0.105);
}

.calendar-card::after {
  position: absolute;
  top: -90rpx;
  right: -80rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(178, 157, 239, 0.16), rgba(247, 182, 204, 0.08));
  content: "";
  pointer-events: none;
}

.calendar-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.calendar-title-wrap {
  display: flex;
  flex-direction: column;
}

.calendar-kicker {
  margin-bottom: 3rpx;
  color: #9588c4;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.calendar-heading {
  color: #3b3c53;
  font-size: 31rpx;
  font-weight: 700;
}

.calendar-swipe-hint {
  color: #aaa7b8;
  font-size: 20rpx;
}

.month-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 66rpx;
  margin-bottom: 14rpx;
  padding: 0 7rpx;
  border-radius: 22rpx;
  background: rgba(242, 239, 250, 0.8);
}

.month-title {
  color: #414258;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.month-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 5rpx 12rpx rgba(68, 55, 108, 0.07);
}

.month-switch:active {
  transform: scale(0.94);
}

.month-switch-icon {
  width: 28rpx;
  height: 28rpx;
}

.calendar-caption {
  position: relative;
  z-index: 1;
  display: block;
  margin: -2rpx 0 14rpx;
  color: #9997a9;
  font-size: 21rpx;
  text-align: center;
}

.calendar-header {
  position: relative;
  z-index: 1;
  display: flex;
  margin-bottom: 5rpx;
  padding: 0 2rpx;
}

.calendar-weekday {
  flex: 1;
  color: #aaa8b7;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
}

.calendar-swiper-mount {
  position: relative;
  z-index: 1;
  width: 100%;
}

.calendar-swiper {
  width: 100%;
  height: 444rpx;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14.28%;
  height: 72rpx;
  box-sizing: border-box;
}

.day-number {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  color: #65667a;
  font-size: 24rpx;
  box-sizing: border-box;
}

.calendar-day.other-month .day-number {
  color: #d1ced9;
}

.calendar-day.is-today .day-number {
  background: #eee9fb;
  color: #6859a8;
  font-weight: 700;
}

.calendar-day.is-selected .day-number {
  background: linear-gradient(145deg, #6f61ad, #9480ce);
  box-shadow: 0 8rpx 18rpx rgba(96, 77, 162, 0.3);
  color: #fff;
  font-weight: 700;
}

.calendar-day.is-selected.is-today .day-number {
  background: linear-gradient(145deg, #6f61ad, #9480ce);
  color: #fff;
}

.checkin-dot {
  position: absolute;
  bottom: 3rpx;
  width: 9rpx;
  height: 9rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(31, 27, 48, 0.14);
}

.selected-date-bar {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 94rpx;
  margin: 0 2rpx 26rpx;
  padding: 14rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 26rpx;
  background: linear-gradient(135deg, #6d5ead 0%, #8a78c7 58%, #9a88d1 100%);
  box-shadow: 0 14rpx 30rpx rgba(92, 74, 155, 0.24);
  box-sizing: border-box;
}

.selected-date-bar::after {
  position: absolute;
  top: -74rpx;
  right: 74rpx;
  width: 180rpx;
  height: 180rpx;
  border: 28rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.selected-date-icon {
  position: relative;
  z-index: 1;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.selected-date-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.selected-date-label {
  margin-bottom: 3rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.selected-date-value {
  overflow: hidden;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-btn {
  position: relative;
  z-index: 1;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 16rpx;
  padding: 13rpx 16rpx 13rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 7rpx 16rpx rgba(57, 43, 108, 0.16);
}

.today-btn-text {
  color: #6758a7;
  font-size: 21rpx;
  font-weight: 650;
}

.today-btn-arrow {
  margin-left: 7rpx;
  color: #8979c2;
  font-size: 28rpx;
  line-height: 20rpx;
}

.today-badge {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 11rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  font-weight: 650;
}
