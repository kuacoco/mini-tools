.checkin-calendar {
  width: 100%;
  box-sizing: border-box;
}

.calendar-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow:
    0 8rpx 32rpx rgba(45, 212, 191, 0.06),
    0 4rpx 16rpx rgba(244, 114, 182, 0.04);
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.month-row {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.month-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #5d5d6b;
  letter-spacing: 0.5rpx;
}

.month-switch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #e0f2fe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-switch-icon {
  width: 32rpx;
  height: 32rpx;
}

.calendar-caption {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 16rpx;
}

.calendar-swiper-mount {
  width: 100%;
}

.calendar-swiper {
  width: 100%;
  height: 540rpx;
}

.calendar-header {
  display: flex;
  margin-bottom: 12rpx;
}

.calendar-weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 14.28%;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.calendar-day.other-month .day-number {
  color: #cbd5e1;
}

.calendar-day.is-today .day-number {
  background: linear-gradient(145deg, #5eead4 0%, #2dd4bf 100%);
  color: #fff;
  border-radius: 50%;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(45, 212, 191, 0.35);
}

.calendar-day.is-selected .day-number {
  background: #f5f3ff;
  color: #7c3aed;
  border: 3rpx solid #c4b5fd;
  border-radius: 50%;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.calendar-day.is-selected.is-today .day-number {
  background: linear-gradient(145deg, #5eead4 0%, #2dd4bf 100%);
  color: #fff;
  border: 3rpx solid #99f6e4;
  box-shadow: 0 4rpx 12rpx rgba(45, 212, 191, 0.35);
}

.day-number {
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
}

.checkin-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
  position: absolute;
  transform: translateY(30rpx);
}

.today-btn {
  font-size: 24rpx;
  color: #0d9488;
  background: #ccfbf1;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.selected-date-bar {
  position: relative;
  text-align: center;
  padding: 12rpx 0 24rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  height: 40rpx;
}

.selected-date-bar::before {
  content: "";
  width: 6rpx;
  height: 28rpx;
  background: #0d9488;
  border-radius: 4rpx;
  margin: 10rpx;
}

.selected-date-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #6b7280;
  margin-right: 10rpx;
}
