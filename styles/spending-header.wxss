.expense-top-card {
  position: relative;
  overflow: hidden;
  margin: 22rpx 24rpx 20rpx;
  padding: 23rpx 25rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff, #f8f5ff);
  box-shadow: 0 18rpx 52rpx rgba(77, 62, 132, 0.12);
}

.summary-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.summary-decoration--one {
  top: -96rpx;
  right: -56rpx;
  width: 260rpx;
  height: 260rpx;
  background: linear-gradient(135deg, rgba(175, 151, 244, 0.2), rgba(239, 178, 206, 0.08));
}

.summary-decoration--two {
  right: 86rpx;
  bottom: -124rpx;
  width: 190rpx;
  height: 190rpx;
  border: 32rpx solid rgba(121, 105, 187, 0.045);
  box-sizing: border-box;
}

.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  display: block;
  color: #8f82bf;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.period-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 16rpx;
  padding: 10rpx 15rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.1);
  border-radius: 999rpx;
  background: rgba(242, 238, 251, 0.9);
}

.period-badge-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #8171bd;
  box-shadow: 0 0 0 5rpx rgba(129, 113, 189, 0.1);
}

.period-badge-text {
  color: #7567aa;
  font-size: 20rpx;
  font-weight: 650;
}

.amount-panel {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 7rpx;
  flex-direction: column;
}

.amount-value {
  margin-top: 5rpx;
  color: #2f3048;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.16;
}

.amount-symbol {
  margin-right: 5rpx;
  color: #5f547f;
  font-size: 36rpx;
  font-weight: 700;
}

.control-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}

.quick-seg {
  display: flex;
  width: 220rpx;
  padding: 4rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.08);
  border-radius: 18rpx;
  background: #efedf5;
  box-sizing: border-box;
}

.quick-seg-item {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 14rpx;
  color: #888798;
  font-size: 21rpx;
  font-weight: 600;
  text-align: center;
}

.quick-seg-item.active {
  background: #fff;
  box-shadow: 0 6rpx 14rpx rgba(69, 57, 108, 0.1);
  color: #675aa6;
  font-weight: 700;
}

.month-pager {
  display: flex;
  align-items: center;
}

.month-pager-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  padding: 13rpx 12rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.09);
  border-radius: 17rpx;
  background: #fff;
  box-shadow: 0 5rpx 13rpx rgba(69, 57, 108, 0.06);
  box-sizing: border-box;
}

.month-pager-btn + .month-pager-btn { margin-left: 9rpx; }

.month-pager-arrow {
  display: block;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
}

.month-pager-text {
  margin: 0 5rpx;
  color: #656579;
  font-size: 20rpx;
  font-weight: 650;
}

.date-range-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 0 8rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.08);
  border-radius: 18rpx;
  background: #efedf5;
}

.date-range-picker { flex: 1; min-width: 0; }

.date-range-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 8rpx;
}

.date-range-trigger--pressed { opacity: 0.6; }

.date-range-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #888798;
  font-size: 20rpx;
}

.date-range-value {
  color: #656579;
  font-size: 23rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.date-range-chevron {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: #7567aa;
  font-size: 22rpx;
}

.date-range-separator {
  flex-shrink: 0;
  padding: 0 4rpx;
  color: #aaa7b6;
  font-size: 20rpx;
}
