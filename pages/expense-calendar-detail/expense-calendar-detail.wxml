<navigation-bar title="日消费明细" home-url="/pages/expense-calendar/expense-calendar" background="#f7f5ff" color="#30314a" />
<page-loader label="日消费明细" ready="{{ pageReady }}" />

<view class="day-ledger-page">
	<view class="page-glow page-glow--left"></view>
	<view class="page-glow page-glow--right"></view>
	<scroll-view class="detail-scroll" type="custom" scroll-y enhanced bounces="{{ false }}" show-scrollbar="{{ false }}">
		<view class="detail-content">
			<view class="detail-hero">
				<view class="hero-decoration hero-decoration--one"></view>
				<view class="hero-decoration hero-decoration--two"></view>
				<view class="hero-topline">
					<text class="detail-kicker">DAILY LEDGER</text>
					<view class="transaction-count-badge">
						<view class="transaction-count-dot"></view>
						<text class="transaction-count-value">{{ transactions.length }}</text>
						<text class="transaction-count-unit">笔消费</text>
					</view>
				</view>

				<view class="date-card">
					<view class="date-icon">日</view>
					<view class="date-copy">
						<text class="date-label">当前日期</text>
						<text class="detail-date">{{ dateTitle }}</text>
					</view>
				</view>

				<view class="detail-total-row">
					<text class="detail-total-label">当天总支出</text>
					<text class="detail-total-value"><text class="detail-total-symbol">¥</text>{{ totalAmountText }}</text>
				</view>
			</view>

			<view class="detail-section-head">
				<view class="section-title-copy">
					<text class="section-kicker">TRANSACTIONS</text>
					<text class="detail-section-title">消费流水</text>
				</view>
				<view class="section-count">
					<text class="section-count-value">{{ transactions.length }}</text>
					<text class="section-count-unit">笔记录</text>
				</view>
			</view>

			<view wx:if="{{ isLoading }}" class="detail-state">
				<view class="loading-mark"></view>
				<text class="state-copy">正在读取当天流水…</text>
			</view>
			<view wx:elif="{{ loadError }}" class="detail-state is-error">
				<view class="error-icon">!</view>
				<text class="state-copy">{{ loadError }}</text>
			</view>
			<view wx:elif="{{ !transactions.length }}" class="detail-state">
				<view class="empty-icon">¥</view>
				<text class="detail-empty-title">这一天还没有消费记录</text>
				<text class="detail-empty-copy">返回日历选择其他日期看看</text>
			</view>
			<view wx:else class="transaction-list">
				<view wx:for="{{ transactions }}" wx:key="rowKey" class="transaction-row {{ item.isLast ? 'is-last' : '' }}">
					<view class="transaction-time">
						<text class="transaction-time-label">时间</text>
						<text class="transaction-clock">{{ item.timeText }}</text>
					</view>
					<view class="transaction-main">
						<text class="transaction-remark">{{ item.remark || '未填写备注' }}</text>
						<text class="transaction-status">消费支出</text>
					</view>
					<text class="transaction-amount">-¥{{ item.amountText }}</text>
				</view>
			</view>
		</view>
	</scroll-view>
</view>
