page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.day-ledger-page {
  flex: 1;
  min-height: 0;
  background: #f8fcfa;
}

.detail-scroll {
  height: 100%;
}

.detail-content {
  padding: 20rpx 24rpx 90rpx;
  box-sizing: border-box;
}

.detail-hero {
  padding: 32rpx 28rpx 26rpx;
  background: #ffffff;
  border: 1rpx solid #d9ebe5;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  box-shadow: 0 16rpx 34rpx rgba(23, 63, 61, 0.06);
}

.detail-kicker,
.detail-date,
.detail-total-label,
.detail-total-value,
.detail-section-title,
.detail-section-note,
.detail-state,
.detail-empty-title,
.detail-empty-copy,
.transaction-clock,
.transaction-remark,
.transaction-amount {
  display: block;
}

.detail-kicker {
  color: #70938b;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.detail-date {
  margin-top: 12rpx;
  color: #173f3d;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 800;
}

.detail-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e7f1ed;
}

.detail-total-label {
  color: #688781;
  font-size: 22rpx;
}

.detail-total-value {
  color: #e2813f;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.detail-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 30rpx 10rpx 14rpx;
}

.detail-section-title {
  color: #173f3d;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-section-note {
  color: #7d9993;
  font-size: 20rpx;
}

.transaction-list {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #d9ebe5;
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  box-shadow: 0 14rpx 30rpx rgba(23, 63, 61, 0.05);
}

.transaction-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #edf5f2;
  box-sizing: border-box;
}

.transaction-row.is-last {
  border-bottom: none;
}

.transaction-time {
  align-self: stretch;
  width: 104rpx;
  flex: none;
  display: flex;
  align-items: center;
  text-align: center;
}

.transaction-clock {
  width: 100%;
  color: #50736c;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.transaction-main {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.transaction-remark {
  color: #254c49;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 650;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.transaction-amount {
  flex: none;
  max-width: 170rpx;
  color: #d56f38;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: right;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.detail-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #d9ebe5;
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  color: #6d8983;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
  box-sizing: border-box;
}

.detail-state.is-error {
  color: #bd5b41;
}

.detail-empty-title {
  color: #365a55;
  font-size: 27rpx;
  font-weight: 700;
}

.detail-empty-copy {
  margin-top: 10rpx;
  color: #849e99;
  font-size: 22rpx;
}
