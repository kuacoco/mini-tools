page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.day-ledger-page {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #f7f5ff 0%, #f8f9fd 46%, #f3f5fa 100%);
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  opacity: 0.44;
  pointer-events: none;
}

.page-glow--left {
  top: -220rpx;
  left: -230rpx;
  background: radial-gradient(circle, rgba(202, 187, 255, 0.74), rgba(202, 187, 255, 0));
}

.page-glow--right {
  top: 500rpx;
  right: -250rpx;
  background: radial-gradient(circle, rgba(255, 193, 213, 0.58), rgba(255, 193, 213, 0));
}

.detail-scroll {
  position: relative;
  z-index: 1;
  height: 100%;
  min-height: 0;
}

.detail-content {
  padding: 22rpx 24rpx calc(90rpx + constant(safe-area-inset-bottom));
  padding: 22rpx 24rpx calc(90rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 24rpx 26rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff, #f8f5ff);
  box-shadow: 0 18rpx 52rpx rgba(77, 62, 132, 0.12);
}

.hero-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-decoration--one {
  top: -96rpx;
  right: -56rpx;
  width: 260rpx;
  height: 260rpx;
  background: linear-gradient(135deg, rgba(175, 151, 244, 0.2), rgba(239, 178, 206, 0.08));
}

.hero-decoration--two {
  right: 76rpx;
  bottom: -122rpx;
  width: 190rpx;
  height: 190rpx;
  border: 32rpx solid rgba(121, 105, 187, 0.045);
  box-sizing: border-box;
}

.hero-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-kicker {
  color: #8f82bf;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.transaction-count-badge {
  display: flex;
  align-items: center;
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.1);
  border-radius: 999rpx;
  background: rgba(242, 238, 251, 0.9);
}

.transaction-count-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #8372bd;
  box-shadow: 0 0 0 5rpx rgba(131, 114, 189, 0.1);
}

.transaction-count-value {
  color: #675aa6;
  font-size: 23rpx;
  font-weight: 750;
}

.transaction-count-unit {
  margin-left: 4rpx;
  color: #918da3;
  font-size: 18rpx;
}

.date-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.08);
  border-radius: 22rpx;
  background: rgba(244, 242, 250, 0.84);
}

.date-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #7868b6, #9985d3);
  box-shadow: 0 8rpx 18rpx rgba(92, 74, 155, 0.2);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.date-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  flex-direction: column;
}

.date-label {
  color: #9e9bac;
  font-size: 18rpx;
}

.detail-date {
  overflow: hidden;
  margin-top: 3rpx;
  color: #414258;
  font-size: 29rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-total-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
}

.detail-total-label {
  padding-bottom: 7rpx;
  color: #9696a9;
  font-size: 21rpx;
}

.detail-total-value {
  color: #303148;
  font-size: 45rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.detail-total-symbol {
  margin-right: 4rpx;
  color: #5f547f;
  font-size: 29rpx;
  font-weight: 700;
}

.detail-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 8rpx 18rpx;
}

.section-title-copy {
  display: flex;
  flex-direction: column;
}

.section-kicker {
  margin-bottom: 5rpx;
  color: #9588c4;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.detail-section-title {
  color: #38394f;
  font-size: 33rpx;
  font-weight: 750;
}

.section-count {
  display: flex;
  align-items: baseline;
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.09);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.section-count-value {
  color: #675ba6;
  font-size: 25rpx;
  font-weight: 750;
}

.section-count-unit {
  margin-left: 5rpx;
  color: #9896a8;
  font-size: 19rpx;
}

.transaction-list {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(68, 55, 108, 0.085);
}

.transaction-row {
  display: flex;
  align-items: center;
  min-height: 106rpx;
  padding: 17rpx 20rpx;
  border-bottom: 1rpx solid rgba(71, 72, 95, 0.06);
  box-sizing: border-box;
}

.transaction-row.is-last { border-bottom: none; }

.transaction-time {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  min-height: 62rpx;
  padding: 7rpx 5rpx;
  border-radius: 17rpx;
  background: #f2eff9;
  flex-direction: column;
  box-sizing: border-box;
}

.transaction-time-label {
  color: #aaa5b7;
  font-size: 16rpx;
}

.transaction-clock {
  margin-top: 4rpx;
  color: #7165a3;
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.transaction-main {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  flex-direction: column;
}

.transaction-remark {
  overflow: hidden;
  color: #48495f;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-status {
  margin-top: 6rpx;
  color: #aaa8b7;
  font-size: 19rpx;
}

.transaction-amount {
  flex: none;
  max-width: 190rpx;
  margin-left: 16rpx;
  overflow: hidden;
  color: #d5677f;
  font-size: 28rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 190rpx;
  padding: 30rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(68, 55, 108, 0.08);
  color: #7e7e91;
  flex-direction: column;
  text-align: center;
  box-sizing: border-box;
}

.loading-mark {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 15rpx;
  border: 5rpx solid #e6e0f3;
  border-top-color: #8473be;
  border-radius: 50%;
}

.state-copy {
  color: #858598;
  font-size: 24rpx;
  line-height: 1.5;
}

.error-icon,
.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 17rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.error-icon {
  background: #fff0f3;
  color: #c65f77;
}

.empty-icon {
  background: #f1edf9;
  color: #7b6caf;
}

.detail-state.is-error .state-copy { color: #bd5b72; }

.detail-empty-title {
  color: #505166;
  font-size: 27rpx;
  font-weight: 700;
}

.detail-empty-copy {
  margin-top: 9rpx;
  color: #9c9bac;
  font-size: 22rpx;
}
