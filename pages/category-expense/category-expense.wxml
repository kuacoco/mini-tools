<navigation-bar title="分类支出" />
<page-loader label="分类支出" ready="{{ pageReady }}" />

<view class="expense-page">
	<view class="page-glow page-glow--left"></view>
	<view class="page-glow page-glow--right"></view>
	<scroll-view class="expense-scroll" type="custom" scroll-y enhanced bounces="{{ false }}" show-scrollbar="{{ false }}">
		<view class="expense-top-card">
			<view class="summary-decoration summary-decoration--one"></view>
			<view class="summary-decoration summary-decoration--two"></view>
			<view class="hero-row">
				<view class="hero-copy">
					<text class="hero-kicker">CATEGORY SPENDING</text>
				</view>
				<view class="period-badge">
					<view class="period-badge-dot"></view>
					<text class="period-badge-text">{{ quickType === 'today' ? '当天' : (quickType === 'month' ? '当月' : '自定义') }}</text>
				</view>
			</view>

			<view class="amount-panel">
				<text class="amount-label">区间总支出</text>
				<text class="amount-value"><text class="amount-symbol">¥</text>{{ totalAmountText }}</text>
			</view>

			<view class="range-panel">
				<view class="range-panel-head">
					<text class="range-panel-title">统计区间</text>
					<text class="range-panel-hint">点击日期调整</text>
				</view>
				<view class="range-row">
					<view class="range-item">
						<picker mode="date" value="{{ startDate }}" bindchange="onStartDateChange">
							<view class="range-value">
								<text class="range-value-text">{{ startDate }}</text>
								<text class="range-value-arrow">›</text>
							</view>
						</picker>
					</view>
					<view class="range-sep">
						<view class="range-sep-line"></view>
						<text class="range-sep-text">至</text>
						<view class="range-sep-line"></view>
					</view>
					<view class="range-item">
						<picker mode="date" value="{{ endDate }}" bindchange="onEndDateChange">
							<view class="range-value">
								<text class="range-value-text">{{ endDate }}</text>
								<text class="range-value-arrow">›</text>
							</view>
						</picker>
					</view>
				</view>
			</view>

			<view class="control-bar">
				<view class="quick-seg" role="tablist" aria-label="快捷选择">
					<view class="quick-seg-item {{ quickType === 'today' ? 'active' : '' }}" bindtap="onQuickToday" role="tab" aria-selected="{{ quickType === 'today' }}">
						当天
					</view>
					<view class="quick-seg-item {{ quickType === 'month' ? 'active' : '' }}" bindtap="onQuickMonth" role="tab" aria-selected="{{ quickType === 'month' }}">
						当月
					</view>
				</view>
				<view class="month-pager">
					<view class="month-pager-btn" bindtap="onPagePrevMonth">
						<image class="month-pager-arrow" src="/pages/statics/arrow-left.svg" mode="aspectFit" />
						<text class="month-pager-text">上月</text>
					</view>
					<view class="month-pager-btn" bindtap="onPageNextMonth">
						<text class="month-pager-text">下月</text>
						<image class="month-pager-arrow" src="/pages/statics/arrow-right.svg" mode="aspectFit" />
					</view>
				</view>
			</view>
		</view>

		<block wx:if="{{ isLoading }}">
			<view class="expense-list">
				<view class="expense-body-card">
					<view class="card-placeholder">
						<text class="placeholder-text">加载中...</text>
					</view>
				</view>
			</view>
		</block>

		<block wx:elif="{{ !sections.length }}">
			<view class="expense-list">
				<view class="expense-body-card">
					<view class="empty-card">
						<text class="empty-title">该区间暂无支出记录</text>
						<text class="empty-desc">可尝试调整日期区间</text>
					</view>
				</view>
			</view>
		</block>

		<block wx:else>
			<view class="list-heading">
				<view class="list-heading-copy">
					<text class="list-kicker">SPENDING BREAKDOWN</text>
					<text class="list-title">分类构成</text>
				</view>
				<view class="list-count">
					<text class="list-count-value">{{ sections.length }}</text>
					<text class="list-count-unit">个一级分类</text>
				</view>
			</view>
			<view wx:for="{{ sections }}" wx:key="group_id" wx:for-item="section" class="category-group">
					<view class="sheet-cat-shell {{ section.collapsed ? 'collapsed' : '' }}">
						<view class="sheet-cat" data-group-id="{{ section.group_id }}" bindtap="onToggleCategory">
							<view class="sheet-cat-icon" style="background-color: {{ section.catIconBg || '#f5f6ff' }}">
								<text class="sheet-cat-icon-text">{{ section.catInitial || '?' }}</text>
							</view>
							<view class="sheet-cat-mid">
								<text class="sheet-cat-name">{{ section.group_name }}</text>
								<text class="sheet-cat-count">{{ section.children.length }} 个二级分类</text>
							</view>
							<view class="sheet-cat-right">
								<text class="sheet-cat-total">¥{{ section.totalText }}</text>
								<view class="sheet-cat-arrow-wrap">
									<text class="sheet-cat-arrow {{ section.collapsed ? 'collapsed' : '' }}">›</text>
								</view>
							</view>
						</view>
					</view>

				<view wx:if="{{ !section.collapsed }}">
					<view class="sheet-rows-shell">
						<view class="sheet-rows">
							<view wx:for="{{ section.children }}" wx:for-item="child" wx:key="group_id" class="sheet-row" data-groupid="{{ child.group_id }}" data-groupname="{{ child.group_name }}" bindtap="onChildTap">
								<view class="child-left">
									<image wx:if="{{ child.icon && child.icon.url }}" class="child-icon" src="{{ child.icon.url }}" mode="aspectFit" />
									<view wx:else class="child-icon-placeholder">{{ child.group_name[0] || '?' }}</view>
									<text class="child-name">{{ child.group_name }}</text>
								</view>
								<view class="child-right">
									<text class="child-amt">¥{{ child.expenseText }}</text>
									<text class="child-arrow">›</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="expense-list-bottom-space" />
		</block>
	</scroll-view>
</view>
