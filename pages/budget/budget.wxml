<navigation-bar title="预算看板" />
<view class="budget-page">
	<scroll-view class="budget-scroll" type="custom" scroll-y enhanced bounces="{{ false }}" show-scrollbar="{{ false }}">
		<sticky-section>
			<sticky-header>
				<view class="budget-sticky-header">
					<view class="summary-card">
						<view class="month-row">
							<view class="month-switch" bindtap="onSummarySwipePrev">
								<image class="month-switch-icon" src="/pages/statics/arrow-left.svg" mode="aspectFit" />
							</view>
							<picker mode="selector" range="{{ monthPickerItems }}" range-key="label" value="{{ currentPickerIndex }}" bindchange="onSelectMonth">
								<view class="month-title-wrap">
									<text class="month-title">{{ monthLabel }}</text>
								</view>
							</picker>
							<view class="month-switch" bindtap="onSummarySwipeNext">
								<image class="month-switch-icon" src="/pages/statics/arrow-right.svg" mode="aspectFit" />
							</view>
						</view>
						<view class="summary-swiper-mount" wx:for="{{ [summarySwiperKey] }}" wx:key="*this">
							<swiper class="summary-swiper" current="{{ swiperSummaryIndex }}" duration="300" easing-function="easeOutCubic" bindchange="onSummarySwiperChange">
								<swiper-item wx:for="{{ summarySwipe }}" wx:for-item="sum" wx:key="monthKey">
									<view class="summary-grid">
										<view class="summary-item">
											<text class="summary-label">总预算</text>
											<text class="summary-value">¥{{ sum.totalBudgetText }}</text>
										</view>
										<view class="summary-item">
											<text class="summary-label">已使用</text>
											<text class="summary-value">¥{{ sum.totalUsedText }}</text>
										</view>
										<view class="summary-item">
											<text class="summary-label">剩余</text>
											<text class="summary-value">¥{{ sum.remainText }}</text>
										</view>
									</view>
								</swiper-item>
							</swiper>
						</view>
					</view>
				</view>
			</sticky-header>

			<view wx:if="{{ showDailyTip }}" class="daily-tip">
				<view class="daily-tip-text">
					<text class="daily-tip-line">预算 ¥{{ dailyBudgetText }}，剩余 ¥{{ dailyRemainText }}</text>
					<text class="daily-tip-line">剩余平均：今日 ¥{{ foodCategoryAvgWithTodayText }}/日，明日 ¥{{ foodCategoryAvgWithoutTodayText }}/日</text>
				</view>
			</view>

			<view class="budget-list-content">
				<view wx:if="{{ !budgetList.length }}" class="empty-card">
					<text class="empty-title">本月还没有预算项</text>
					<text class="empty-desc">点击下方 + 添加第一条预算</text>
				</view>

				<view wx:for="{{ budgetList }}" wx:key="id" class="swipe-row">
					<view class="swipe-action edit" data-id="{{ item.id }}" bindtap="onEditBudgetAction">编辑</view>
					<view class="swipe-action delete" data-id="{{ item.id }}" bindtap="onDeleteBudgetAction">删除</view>
					<view
						class="budget-item"
						style="transform: translateX({{ item.offsetX }}px);"
						data-id="{{ item.id }}"
						catchtap="onBudgetTap"
						bindtouchstart="onItemTouchStart"
						bindtouchmove="onItemTouchMove"
						bindtouchend="onItemTouchEnd"
						bindtouchcancel="onItemTouchEnd"
					>
						<view class="item-header">
							<text class="item-name">{{ item.name }}</text>
							<text class="item-percent">{{ item.percentText }}</text>
						</view>
						<view class="amount-row">
							<text>已用 ¥{{ item.usedText }} / 预算 ¥{{ item.totalText }}</text>
						</view>
						<view class="progress-track" style="background: {{ item.trackColor }}">
							<view class="progress-fill" style="width: {{ item.barWidth }}; background: {{ item.barColor }}"></view>
						</view>
						<view class="remain-row {{ item.isOver ? 'over' : '' }}">
							{{ item.isOver ? '已超支' : '剩余' }} ¥{{ item.remainText }}
						</view>
					</view>
				</view>

				<view wx:if="{{ isWhitelisted && subscribeCount > 0 }}" class="budget-footer">
					<text class="budget-footer-text">订阅 × {{ subscribeCount }}</text>
				</view>
			</view>
		</sticky-section>
	</scroll-view>

	<view wx:if="{{ showFabMenu }}" class="fab-mask {{ fabMenuClosing ? 'is-leaving' : 'is-entering' }}" bindtap="onClosePopup"></view>
	<view class="fab-wrap">
		<view wx:if="{{ showFabMenu }}" class="fab-menu {{ fabMenuClosing ? 'is-leaving' : 'is-entering' }}">
			<view wx:if="{{ isWhitelisted }}" class="fab-menu-item" bindtap="onSyncFromFeidee">同步数据</view>
			<view wx:if="{{ isWhitelisted }}" class="fab-menu-item" bindtap="onGoToCategoryExpense">分类支出</view>
			<!-- <view wx:if="{{ isWhitelisted }}" class="fab-menu-item" bindtap="onImportBudgetByImage">图片导入</view>
			<view wx:if="{{ isWhitelisted }}" class="fab-menu-item" bindtap="onSubscribeNotification">订阅通知</view> -->
			<view wx:if="{{ isAdminUser }}" class="fab-menu-item" bindtap="onGoToAdmin">配置管理</view>
			<view class="fab-menu-item" bindtap="onOpenCopyPopup">复制预算</view>
			<view class="fab-menu-item" bindtap="onOpenAddPopup">新增预算项</view>
		</view>
		<view class="add-btn {{ showFabMenu && !fabMenuClosing ? 'is-active' : '' }}" bindtap="onToggleFabMenu">
			<image class="add-btn-icon" src="/pages/statics/plus.svg" mode="aspectFit" />
		</view>
	</view>

	<view wx:if="{{ showAddPopup }}" class="popup-mask {{ addPopupClosing ? 'is-leaving' : 'is-entering' }}" bindtap="onClosePopup">
		<view class="popup-sheet" catchtap="noop">
			<view class="popup-head">
				<text class="popup-title">{{ addPopupTitle }}</text>
				<view class="popup-close" bindtap="onClosePopup"><image class="popup-close-icon" src="/pages/statics/close.svg" mode="aspectFit"/></view>
			</view>
			<view class="popup-content">
				<view class="popup-item">
					<text class="popup-label">预算项名称</text>
					<input class="popup-input" placeholder="例如：餐饮 / 交通 / 娱乐" maxlength="20" value="{{ addName }}" bindinput="onAddNameInput" />
				</view>
				<view class="popup-item">
					<text class="popup-label">预算金额</text>
					<view class="used-input">¥ {{ addTotalAmount }}</view>
					<view wx:if="{{ addAmountFormula }}" class="calc-formula">{{ addAmountFormula }}</view>
				</view>
				<amount-keyboard
					primaryButtonText="{{ addPopupMode === 'edit' ? '保存修改' : '保存预算项' }}"
					initialReset="{{ addKeyboardReset }}"
					initialExpression="{{ addInitialExpression }}"
					bindchange="onAddKeyboardChange"
					bindprimary="onSaveBudgetItem"
				/>
			</view>
		</view>
	</view>

	<view wx:if="{{ showUsedPopup }}" class="popup-mask {{ usedPopupClosing ? 'is-leaving' : 'is-entering' }}" bindtap="onClosePopup">
		<view class="popup-sheet" catchtap="noop">
			<view class="popup-head">
				<text class="popup-title">设置已使用额度</text>
				<view class="popup-close" bindtap="onClosePopup"><image class="popup-close-icon" src="/pages/statics/close.svg" mode="aspectFit"/></view>
			</view>
			<view class="used-meta">
				<text class="used-name">{{ usedItemName }}</text>
				<text class="used-total">预算 ¥{{ usedItemTotalText }}</text>
			</view>
			<view class="used-input">¥ {{ usedInput }}</view>
			<view wx:if="{{ usedAmountFormula }}" class="calc-formula">{{ usedAmountFormula }}</view>
			<amount-keyboard
				primaryButtonText="保存"
				initialReset="{{ usedKeyboardReset }}"
				initialExpression="{{ usedInitialExpression }}"
				bindchange="onUsedKeyboardChange"
				bindprimary="onSaveUsedAmount"
			/>
		</view>
	</view>

	<view wx:if="{{ showCopyPopup }}" class="popup-mask {{ copyPopupClosing ? 'is-leaving' : 'is-entering' }}" bindtap="onClosePopup">
		<view class="popup-sheet" catchtap="noop">
			<view class="popup-head">
				<text class="popup-title">复制预算项</text>
				<view class="popup-close" bindtap="onClosePopup"><image class="popup-close-icon" src="/pages/statics/close.svg" mode="aspectFit"/></view>
			</view>
			<view class="popup-content">
				<view class="popup-item">
					<text class="popup-label">源月份</text>
					<picker mode="selector" range="{{ monthPickerItems }}" range-key="label" value="{{ copySourceMonthIndex }}" bindchange="onSelectCopySourceMonth">
						<view class="popup-picker-trigger">
							<text class="popup-picker-value">{{ monthPickerItems[copySourceMonthIndex].label }}</text>
							<view class="popup-picker-arrow"></view>
						</view>
					</picker>
				</view>
				<view class="popup-copy-btn" bindtap="onConfirmCopy">确认复制</view>
			</view>
		</view>
	</view>
</view>
