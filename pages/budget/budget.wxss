page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.fab-menu-item.fab-menu-item-danger {
  color: #c45f73;
}

.budget-page {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #f7f5ff 0%, #f8f9fd 42%, #f4f6fb 100%);
  box-sizing: border-box;
}

.page-glow {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  filter: blur(10rpx);
  opacity: 0.42;
  pointer-events: none;
}

.page-glow-left {
  top: -220rpx;
  left: -210rpx;
  background: radial-gradient(circle, rgba(202, 187, 255, 0.72), rgba(202, 187, 255, 0));
}

.page-glow-right {
  top: 280rpx;
  right: -260rpx;
  background: radial-gradient(circle, rgba(255, 199, 215, 0.62), rgba(255, 199, 215, 0));
}

.budget-scroll {
  position: relative;
  z-index: 1;
  height: 100%;
  min-height: 0;
}

.budget-header {
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.budget-list-content {
  padding: 4rpx 24rpx 156rpx;
  box-sizing: border-box;
}

.daily-tip {
  padding: 0 24rpx 20rpx;
  box-sizing: border-box;
}

.daily-tip-text {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid rgba(129, 112, 192, 0.12);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(67, 55, 111, 0.07);
  backdrop-filter: blur(18rpx);
}

.daily-tip-heading {
  flex: none;
  padding-right: 24rpx;
}

.daily-tip-category {
  display: block;
  color: #625394;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.daily-tip-caption {
  display: block;
  margin-top: 4rpx;
  color: #9290a6;
  font-size: 20rpx;
}

.daily-tip-body {
  display: flex;
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
  border-left: 1rpx solid #ebe7f4;
}

.daily-tip-metric {
  flex: 1;
  min-width: 0;
}

.daily-tip-metric-next {
  margin-left: 16rpx;
}

.daily-tip-label {
  display: block;
  color: #9290a6;
  font-size: 20rpx;
  line-height: 1.5;
}

.daily-tip-value {
  display: block;
  margin-top: 4rpx;
  color: #625394;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  overflow-wrap: break-word;
}

.summary-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 30rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(244, 241, 255, 0.96));
  box-shadow: 0 18rpx 52rpx rgba(77, 62, 132, 0.13);
}

.summary-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.summary-decoration-one {
  top: -86rpx;
  right: -52rpx;
  width: 250rpx;
  height: 250rpx;
  background: linear-gradient(135deg, rgba(175, 151, 244, 0.2), rgba(239, 178, 206, 0.08));
}

.summary-decoration-two {
  right: 86rpx;
  bottom: -118rpx;
  width: 190rpx;
  height: 190rpx;
  border: 34rpx solid rgba(121, 105, 187, 0.05);
}

.summary-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-kicker {
  color: #7669ae;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
}

.summary-swipe-hint {
  color: #aaa7ba;
  font-size: 19rpx;
}

.month-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 14rpx 0 20rpx;
}

.month-row picker {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 0;
}

.month-title-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx 16rpx;
}

.month-title {
  color: #282a43;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.summary-swiper-mount {
  width: 100%;
}

.summary-swiper {
  width: 100%;
  height: 142rpx;
}

.month-switch {
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(111, 97, 176, 0.1);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.76);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(83, 69, 137, 0.08);
}

.month-switch-icon {
  width: 30rpx;
  height: 30rpx;
}

.budget-footer {
  display: flex;
  justify-content: center;
  padding: 18rpx 0 8rpx;
}

.budget-footer-text {
  font-size: 22rpx;
  color: rgba(138, 141, 167, 0.9);
  letter-spacing: 0.5rpx;
}

.summary-overview {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  height: 100%;
  box-sizing: border-box;
}

.summary-primary {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 26rpx;
  border-right: 1rpx solid rgba(100, 91, 145, 0.12);
}

.summary-label {
  margin-bottom: 10rpx;
  color: #9292a6;
  font-size: 22rpx;
}

.summary-primary-value {
  color: #2c2d46;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.summary-side {
  width: 248rpx;
  padding-left: 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.summary-side-item {
  display: flex;
  align-items: center;
}

.summary-side-item + .summary-side-item {
  margin-top: 20rpx;
}

.summary-side-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
}

.summary-side-dot.used {
  background: #f1a9ba;
  box-shadow: 0 0 0 7rpx rgba(241, 169, 186, 0.14);
}

.summary-side-dot.remain {
  background: #7fc5aa;
  box-shadow: 0 0 0 7rpx rgba(127, 197, 170, 0.14);
}

.summary-side-label,
.summary-side-value {
  display: block;
}

.summary-side-label {
  margin-bottom: 3rpx;
  color: #9a99ab;
  font-size: 19rpx;
}

.summary-side-value {
  color: #41435c;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-card {
  margin-top: 8rpx;
  padding: 72rpx 28rpx;
  border: 1rpx dashed rgba(113, 101, 172, 0.24);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
  box-shadow: 0 14rpx 36rpx rgba(52, 50, 86, 0.05);
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: #42445f;
  font-size: 31rpx;
  font-weight: 600;
}

.empty-desc {
  color: #9697a8;
  font-size: 24rpx;
}

.budget-group {
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(114, 104, 160, 0.09);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 40rpx rgba(53, 51, 91, 0.08);
  overflow: hidden;
  backdrop-filter: blur(18rpx);
}

.group-summary {
  padding: 28rpx 28rpx 24rpx;
  background: linear-gradient(135deg, rgba(252, 250, 255, 0.98), rgba(247, 247, 253, 0.96));
  border-bottom: 1rpx solid rgba(114, 104, 160, 0.09);
}

.group-title-row,
.group-identity,
.group-progress-row,
.child-name-wrap,
.children-heading {
  display: flex;
  align-items: center;
}

.group-title-row,
.children-heading {
  justify-content: space-between;
}

.group-identity {
  min-width: 0;
}

.group-accent {
  flex: none;
  width: 10rpx;
  height: 58rpx;
  margin-right: 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 14rpx rgba(74, 65, 118, 0.12);
}

.group-title-copy {
  min-width: 0;
}

.group-eyebrow {
  display: block;
  margin-bottom: 3rpx;
  color: #a09eaf;
  font-size: 19rpx;
  letter-spacing: 0.6rpx;
}

.group-name {
  display: block;
  max-width: 390rpx;
  color: #303149;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-edit {
  flex: none;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(112, 97, 175, 0.1);
  border-radius: 999rpx;
  color: #6d61a6;
  background: rgba(239, 235, 255, 0.8);
  font-size: 22rpx;
}

.group-metrics {
  display: flex;
  margin-top: 26rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(105, 101, 136, 0.08);
  border-bottom: 1rpx solid rgba(105, 101, 136, 0.08);
}

.group-metric {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
  border-right: 1rpx solid rgba(105, 101, 136, 0.09);
}

.group-metric:first-child {
  padding-left: 0;
}

.group-metric-last {
  padding-right: 0;
  border-right: none;
}

.group-metric-label,
.group-metric-value {
  display: block;
}

.group-metric-label {
  margin-bottom: 7rpx;
  color: #9999aa;
  font-size: 20rpx;
}

.group-metric-value {
  color: #41425b;
  font-size: 25rpx;
  font-weight: 600;
}

.group-metric-value.over {
  color: #cf667d;
}

.group-progress-row {
  margin-top: 20rpx;
}

.group-progress {
  flex: 1;
  height: 12rpx;
}

.group-percent {
  flex: none;
  width: 76rpx;
  color: #6c6e85;
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
}

.group-children {
  padding: 20rpx;
  background: rgba(249, 249, 253, 0.66);
}

.children-heading {
  padding: 0 6rpx 16rpx;
}

.children-heading-title {
  color: #686a82;
  font-size: 22rpx;
  font-weight: 600;
}

.children-heading-hint {
  color: #aaaaba;
  font-size: 19rpx;
}

.child-swipe-row {
  margin-bottom: 12rpx;
  border-radius: 18rpx;
}

.child-swipe-row:last-child {
  margin-bottom: 0;
}

.child-budget-item {
  border: 1rpx solid rgba(111, 107, 142, 0.08);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  box-shadow: none;
  background: rgba(255, 255, 255, 0.96);
}

.child-name-wrap {
  min-width: 0;
}

.child-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
}

.child-remain {
  flex: none;
  margin-left: 16rpx;
  color: #6d6e83;
  font-size: 22rpx;
}

.child-remain.over {
  color: #cf667d;
}

.swipe-row {
  position: relative;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.swipe-action {
  position: absolute;
  top: 0;
  width: 164rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
}

.swipe-action.edit {
  left: 0;
  background: linear-gradient(135deg, #8b80ce 0%, #6faec3 100%);
}

.swipe-action.delete {
  right: 0;
  background: linear-gradient(135deg, #ef9fb2 0%, #ce647c 100%);
}

.budget-item {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(41, 51, 89, 0.08);
  transition: transform 0.18s ease;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.item-name {
  min-width: 0;
  color: #3b3c54;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #9292a5;
  font-size: 24rpx;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  min-width: 0;
  transition: width 0.28s ease-out;
}

.fab-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(30, 28, 48, 0.22);
  backdrop-filter: blur(6rpx);
  z-index: 996;
}

.fab-mask.is-entering {
  animation: maskFadeIn 180ms ease-out forwards;
}

.fab-mask.is-leaving {
  animation: maskFadeOut 160ms ease-in forwards;
}

.fab-wrap {
  position: fixed;
  right: 32rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 997;
}

.fab-menu {
  position: absolute;
  right: 0;
  bottom: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  transform-origin: right bottom;
}

.fab-menu-item + .fab-menu-item {
  margin-top: 14rpx;
}

.fab-menu.is-entering {
  animation: fabMenuIn 200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.fab-menu.is-leaving {
  animation: fabMenuOut 160ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.fab-menu-item {
  min-width: 184rpx;
  height: 72rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(55, 45, 94, 0.17);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #46465e;
  font-size: 26rpx;
  font-weight: 600;
}

.add-btn {
  width: 100rpx;
  height: 100rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  background: linear-gradient(145deg, #7b6cbd 0%, #a48ada 58%, #e5a7bf 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 34rpx rgba(103, 84, 167, 0.34);
  box-sizing: border-box;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.add-btn.is-active {
  transform: rotate(45deg) scale(1.03);
  box-shadow: 0 16rpx 30rpx rgba(123, 97, 182, 0.42);
}

.add-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

@keyframes fabMenuIn {
  from {
    opacity: 0;
    transform: translateY(14rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes fabMenuOut {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(14rpx) scale(0.94);
  }
}

.popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(29, 29, 45, 0.46);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.popup-sheet {
  width: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  background: linear-gradient(180deg, #ffffff 0%, #f8f8fd 100%);
  border-radius: 34rpx 34rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  transform-origin: bottom center;
}

.popup-mask.is-entering {
  animation: maskFadeIn 220ms ease-out forwards;
}

.popup-mask.is-entering .popup-sheet {
  animation: sheetSlideUp 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.popup-mask.is-leaving {
  animation: maskFadeOut 220ms ease-out forwards;
}

.popup-mask.is-leaving .popup-sheet {
  animation: sheetSlideDown 240ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes maskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheetSlideUp {
  from {
    opacity: 0;
    transform: translateY(42rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes maskFadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes sheetSlideDown {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(42rpx);
  }
}

.popup-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.popup-title {
  color: #303149;
  font-size: 34rpx;
  font-weight: 700;
}

.popup-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(110, 99, 166, 0.08);
  background: #f2f1f9;
}

.popup-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.popup-content {
  padding-top: 4rpx;
}

.popup-item {
  margin-bottom: 20rpx;
}

.popup-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  color: #66677e;
}

.popup-input {
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(111, 101, 163, 0.09);
  border-radius: 16rpx;
  background: #f4f4fa;
  font-size: 30rpx;
  color: #30334f;
}

.used-meta {
  margin-bottom: 14rpx;
}

.used-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #3a3d5e;
}

.used-total {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a8da7;
}

.used-input {
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(111, 101, 163, 0.09);
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f3f1fb, #f8f7fc);
  color: #303149;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.calc-formula {
  margin-top: -6rpx;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
  color: #8a8da7;
  font-size: 22rpx;
  line-height: 1.5;
}

.popup-static-value {
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(111, 101, 163, 0.09);
  border-radius: 16rpx;
  background: #f4f4fa;
  font-size: 30rpx;
  color: #30334f;
}

.popup-picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(111, 101, 163, 0.09);
  border-radius: 16rpx;
  background: #f4f4fa;
}

.popup-picker-value {
  font-size: 30rpx;
  color: #30334f;
}

.popup-picker-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #8a8da7;
}

.popup-copy-hint {
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.popup-copy-hint text {
  font-size: 24rpx;
  color: #8a8da7;
}

.popup-copy-btn {
  margin-top: 40rpx;
  width: 240rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #7568b4 0%, #9b82d1 62%, #d99bb6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin-left: auto;
  margin-right: auto;
  box-shadow: 0 12rpx 26rpx rgba(104, 84, 166, 0.23);
}

.parent-edit-hint {
  margin-top: 8rpx;
  color: #8a8da7;
  font-size: 23rpx;
  line-height: 1.6;
}
