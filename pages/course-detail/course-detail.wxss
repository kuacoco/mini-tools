page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.detail-page {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #f7f5ff 0%, #f8f9fd 48%, #f3f5fa 100%);
  box-sizing: border-box;
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  opacity: 0.46;
  pointer-events: none;
}

.page-glow--left {
  top: -230rpx;
  left: -230rpx;
  background: radial-gradient(circle, rgba(194, 180, 255, 0.76), rgba(194, 180, 255, 0));
}

.page-glow--right {
  top: 620rpx;
  right: -250rpx;
  background: radial-gradient(circle, rgba(255, 192, 211, 0.58), rgba(255, 192, 211, 0));
}

.detail-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.top-placeholder { height: 20rpx; }

.bottom-placeholder {
  height: calc(34rpx + constant(safe-area-inset-bottom));
  height: calc(34rpx + env(safe-area-inset-bottom));
}

.hero-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 22rpx;
  padding: 26rpx 26rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  background: linear-gradient(148deg, #fff, #f8f6ff);
  box-shadow: 0 18rpx 48rpx rgba(68, 55, 108, 0.11);
}

.hero-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-decoration--one {
  top: -108rpx;
  right: -66rpx;
  width: 270rpx;
  height: 270rpx;
  background: linear-gradient(145deg, rgba(174, 152, 239, 0.19), rgba(247, 173, 200, 0.08));
}

.hero-decoration--two {
  right: 76rpx;
  bottom: -112rpx;
  width: 180rpx;
  height: 180rpx;
  border: 30rpx solid rgba(116, 98, 178, 0.045);
  box-sizing: border-box;
}

.hero-kicker-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.hero-kicker {
  color: #8f82bf;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-mode {
  padding: 9rpx 15rpx;
  border: 1rpx solid rgba(112, 95, 173, 0.1);
  border-radius: 999rpx;
  background: rgba(240, 236, 250, 0.88);
  color: #796ca8;
  font-size: 20rpx;
  font-weight: 600;
}

.hero-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 102rpx;
  height: 102rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 33rpx;
  box-shadow: 0 12rpx 27rpx rgba(57, 48, 91, 0.18);
  box-sizing: border-box;
}

.hero-char {
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 7rpx rgba(40, 35, 67, 0.22);
}

.hero-text {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 24rpx;
}

.hero-name {
  overflow: hidden;
  color: #34354c;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #9999aa;
  font-size: 22rpx;
  line-height: 1.4;
}

.hero-stats-grid {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 28rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(115, 98, 177, 0.08);
  border-radius: 24rpx;
  background: rgba(244, 242, 250, 0.88);
}

.hero-stat-card {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 16rpx 4rpx;
  flex-direction: column;
  border-radius: 18rpx;
}

.hero-stat-card--active {
  background: #fff;
  box-shadow: 0 7rpx 18rpx rgba(70, 58, 110, 0.08);
}

.hero-stat-label {
  margin-bottom: 6rpx;
  color: #9998aa;
  font-size: 20rpx;
}

.hero-stat-value {
  color: #44455d;
  font-size: 32rpx;
  font-weight: 750;
}

.hero-stat-card--active .hero-stat-value {
  color: #6559a2;
}

.hero-progress-wrap {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.hero-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 13rpx;
}

.hero-progress-title {
  display: flex;
  align-items: center;
}

.hero-progress-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 0 0 5rpx rgba(112, 95, 173, 0.09);
}

.hero-progress-label {
  color: #88899d;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-percent {
  color: #53546a;
  font-size: 27rpx;
  font-weight: 750;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.25s ease-out;
}

.section {
  margin-top: 2rpx;
  padding: 28rpx 26rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 16rpx 42rpx rgba(68, 55, 108, 0.085);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title-wrap {
  display: flex;
  flex-direction: column;
}

.section-kicker {
  margin-bottom: 5rpx;
  color: #9588c4;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.section-title {
  color: #37384f;
  font-size: 32rpx;
  font-weight: 750;
}

.log-count {
  display: flex;
  align-items: baseline;
  padding: 9rpx 15rpx;
  border: 1rpx solid rgba(112, 95, 173, 0.09);
  border-radius: 999rpx;
  background: #f3f0fb;
}

.log-count-value {
  color: #675ba6;
  font-size: 25rpx;
  font-weight: 750;
}

.log-count-unit {
  margin-left: 4rpx;
  color: #9894aa;
  font-size: 19rpx;
}

.log-empty {
  display: flex;
  align-items: center;
  padding: 32rpx 0 38rpx;
  flex-direction: column;
  text-align: center;
}

.log-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 17rpx;
  border-radius: 23rpx;
  background: #f0ecfa;
  color: #8272bd;
  font-size: 30rpx;
  font-weight: 700;
}

.log-empty-title {
  margin-bottom: 7rpx;
  color: #56576d;
  font-size: 26rpx;
  font-weight: 650;
}

.log-empty-text {
  color: #a0a0b0;
  font-size: 22rpx;
}

.log-row {
  display: flex;
  align-items: flex-start;
  min-height: 78rpx;
  padding: 12rpx 0 16rpx;
}

.log-row--last {
  padding-bottom: 6rpx;
}

.log-marker {
  position: relative;
  display: flex;
  align-self: stretch;
  justify-content: center;
  width: 54rpx;
  flex-shrink: 0;
}

.log-dot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 5rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 5rpx 12rpx rgba(57, 48, 91, 0.15);
  color: #fff;
  font-size: 19rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.log-line {
  position: absolute;
  top: 34rpx;
  bottom: -18rpx;
  left: 26rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #dfd9ee, #efecf6);
}

.log-body {
  flex: 1;
  min-width: 0;
  padding: 1rpx 16rpx 0 8rpx;
}

.log-date {
  display: block;
  color: #47485f;
  font-size: 27rpx;
  font-weight: 650;
}

.log-note {
  display: block;
  margin-top: 7rpx;
  color: #8f90a3;
  font-size: 22rpx;
  line-height: 1.45;
}

.log-note--empty { color: #aeacba; }

.log-status {
  flex-shrink: 0;
  margin-top: 2rpx;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  background: #f3f0fb;
  color: #7b6daf;
  font-size: 19rpx;
  font-weight: 600;
}

.error-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  flex-direction: column;
}

.error-text {
  margin-bottom: 28rpx;
  color: #6e6f82;
  font-size: 27rpx;
  line-height: 1.5;
  text-align: center;
}

.error-btn {
  padding: 20rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #6e60ad, #9783d3);
  box-shadow: 0 10rpx 24rpx rgba(95, 77, 162, 0.25);
  color: #fff;
  font-size: 27rpx;
  font-weight: 650;
}
