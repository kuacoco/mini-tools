page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.detail-page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(
    180deg,
    #f0fdf9 0%,
    #ecfeff 40%,
    #fdf2f8 80%,
    #ffffff 100%
  );
  box-sizing: border-box;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.top-placeholder {
  height: 28rpx;
}

.bottom-placeholder {
  height: calc(28rpx + constant(safe-area-inset-bottom));
  height: calc(28rpx + env(safe-area-inset-bottom));
}

.hero-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 32rpx 28rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 8rpx 32rpx rgba(45, 212, 191, 0.06),
    0 4rpx 16rpx rgba(244, 114, 182, 0.04);
  margin-bottom: 28rpx;
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hero-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.hero-char {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
}

.hero-text {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  margin-left: 28rpx;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #3f3f4d;
  line-height: 1.35;
  margin-bottom: 8rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-stats-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

.hero-stats-row .hero-stat:first-child {
  margin-right: 8rpx;
}

.hero-stat {
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
}

.hero-stat--muted {
  color: #94a3b8;
}

.hero-stat-sep {
  font-size: 22rpx;
  color: #cbd5e1;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.hero-progress-wrap {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.25);
}

.hero-progress-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}

.hero-progress-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

.hero-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: #5d5d6b;
  letter-spacing: 0.5rpx;
}

.progress-track {
  width: 100%;
  height: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.25s ease-out;
}

.section {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 28rpx rgba(45, 212, 191, 0.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #5d5d6b;
  margin-bottom: 20rpx;
}

.log-empty {
  padding: 32rpx 0;
  text-align: center;
}

.log-empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.log-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.9);
}

.log-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.log-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.log-body {
  flex: 1;
  min-width: 0;
}

.log-date {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #475569;
}

.log-note {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.error-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.error-text {
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 32rpx;
}

.error-btn {
  font-size: 28rpx;
  color: #0d9488;
  background: #ccfbf1;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-weight: 500;
}
