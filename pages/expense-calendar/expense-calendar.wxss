page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.spending-calendar-page {
  flex: 1;
  min-height: 0;
  background: #f4fbf7;
}

.calendar-scroll {
  height: 100%;
}

.calendar-content {
  padding: 20rpx 24rpx 88rpx;
  box-sizing: border-box;
}

.month-control-row {
  display: flex;
  align-items: flex-start;
}

.month-picker {
  min-width: 228rpx;
  padding: 14rpx 20rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid #d9ebe5;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 18rpx rgba(23, 63, 61, 0.05);
  box-sizing: border-box;
}

.month-picker--active {
  background: #e8f5f0;
}

.month-picker-label,
.month-picker-value,
.month-picker-arrow,
.ledger-kicker,
.ledger-title,
.ledger-caption,
.ledger-total-label,
.ledger-total-value,
.calendar-meta-title,
.calendar-meta-note,
.week-label,
.day-number,
.day-amount,
.calendar-status,
.calendar-hint {
  display: block;
}

.month-picker-label {
  font-size: 20rpx;
  color: #6b8985;
  letter-spacing: 1rpx;
}

.month-picker-value-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.month-picker-value {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #173f3d;
}

.month-picker-arrow {
  margin-left: 12rpx;
  color: #4b7771;
  font-size: 30rpx;
  line-height: 1;
}

.ledger-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 30rpx 28rpx;
  background: #173f3d;
  border-radius: 26rpx 26rpx 8rpx 26rpx;
  box-sizing: border-box;
}

.ledger-hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.ledger-kicker {
  font-size: 18rpx;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #90cabe;
  font-weight: 700;
}

.ledger-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  line-height: 1.28;
  color: #ffffff;
  font-weight: 700;
}

.ledger-caption {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #b8d9d2;
}

.ledger-total {
  flex: none;
  max-width: 250rpx;
  text-align: right;
}

.ledger-total-label {
  font-size: 20rpx;
  color: #b8d9d2;
}

.ledger-total-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 1.2;
  color: #ffcf7b;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.calendar-shell {
  margin-top: 18rpx;
  padding: 24rpx 14rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid #d9ebe5;
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  box-shadow: 0 18rpx 38rpx rgba(23, 63, 61, 0.07);
  box-sizing: border-box;
}

.calendar-meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 12rpx 18rpx;
}

.calendar-meta-title {
  font-size: 26rpx;
  color: #173f3d;
  font-weight: 700;
}

.calendar-meta-note {
  font-size: 20rpx;
  color: #6b8985;
}

.week-header {
  display: flex;
}

.month-grid {
  display: flex;
  flex-direction: column;
}

.calendar-week-row {
  display: flex;
  width: 100%;
}

.week-label,
.day-cell {
  flex: 1 0 0;
  width: auto;
  min-width: 0;
  max-width: none;
  box-sizing: border-box;
}

.week-label {
  padding: 10rpx 0 12rpx;
  color: #86a39e;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
}

.day-cell {
  min-height: 120rpx;
  padding: 12rpx 3rpx 8rpx;
  border-top: 1rpx solid #edf5f2;
  border-right: 1rpx solid #edf5f2;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.day-cell.is-week-end {
  border-right: none;
}

.day-cell.is-placeholder {
  background: #fbfdfc;
}

.day-cell.tone-1 {
  background: #edf8f4;
}

.day-cell.tone-2 {
  background: #d6eee6;
}

.day-cell.tone-3 {
  background: #a8dccc;
}

.day-cell.tone-4 {
  background: #5da994;
}

.day-cell.is-today {
  box-shadow: inset 0 0 0 2rpx #f2a950;
}

.day-cell--pressed {
  opacity: 0.7;
}

.day-number {
  font-size: 25rpx;
  line-height: 1;
  color: #244b48;
  font-weight: 700;
}

.day-amount {
  width: 100%;
  margin-top: 14rpx;
  padding: 0 1rpx;
  color: #56746f;
  font-size: 17rpx;
  line-height: 1.2;
  text-align: center;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tone-3 .day-number,
.tone-4 .day-number,
.tone-3 .day-amount,
.tone-4 .day-amount {
  color: #ffffff;
}

.calendar-status {
  min-height: 58rpx;
  padding: 18rpx 12rpx 0;
  color: #62807b;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}

.calendar-status.is-error {
  color: #bd5b41;
}

.calendar-hint {
  display: flex;
  align-items: center;
  margin: 22rpx 10rpx 0;
  color: #66847f;
  font-size: 22rpx;
  line-height: 1.4;
}

.calendar-hint-dot {
  margin-right: 10rpx;
  color: #f2a950;
  font-size: 16rpx;
}
