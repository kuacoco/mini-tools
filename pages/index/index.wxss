/** index.wxss 工具首页 **/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f5ff;
}

.home-scroll {
  flex: 1;
  min-height: 0;
}

.home-page {
  min-height: 100%;
  padding: 38rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 100% 4%, rgba(230, 224, 255, 0.74) 0%, rgba(230, 224, 255, 0) 25%),
    #f7f5ff;
}

.home-intro {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.intro-copy {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.intro-kicker,
.intro-title,
.intro-desc {
  display: block;
}

.intro-kicker {
  color: #7772a4;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2.4rpx;
}

.intro-title {
  margin-top: 20rpx;
  color: #30327b;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.22;
  letter-spacing: 0.6rpx;
}

.intro-desc {
  margin-top: 18rpx;
  color: #8783a7;
  font-size: 25rpx;
  line-height: 1.4;
}

.toolbox-mark {
  position: relative;
  flex: 0 0 138rpx;
  width: 138rpx;
  height: 138rpx;
  border: 2rpx solid #e6e0ff;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.7);
  transform: rotate(5deg);
}

.toolbox-square {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.toolbox-square:nth-child(1) {
  top: 18rpx;
  left: 18rpx;
}

.toolbox-square:nth-child(2) {
  top: 18rpx;
  right: 18rpx;
}

.toolbox-square:nth-child(3) {
  bottom: 18rpx;
  left: 18rpx;
}

.toolbox-square:nth-child(4) {
  right: 18rpx;
  bottom: 18rpx;
}

.toolbox-square--purple {
  background: #8c83d7;
}

.toolbox-square--yellow {
  background: #ffd96a;
}

.toolbox-square--blue {
  background: #8ae3f1;
}

.toolbox-square--coral {
  background: #ff9b8c;
}

.tool-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 48rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #30327b;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-note {
  display: flex;
  align-items: center;
  color: #908bad;
  font-size: 21rpx;
}

.section-note-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #8c83d7;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.tool-item {
  width: calc((100% - 18rpx) / 2);
  min-height: 282rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transition: transform 160ms ease, opacity 160ms ease;
}

.tool-item--active {
  opacity: 0.84;
  transform: scale(0.975);
}

.tool-item--spending-calendar {
  background: #dff4e9;
}

.tool-item--budget {
  background: #ffddd8;
}

.tool-item--spending-bill {
  background: #f5e2f1;
}

.tool-item--course {
  background: #e6e0ff;
}

.tool-item--qing-calendar {
  background: #ddf6ff;
}

.tool-item--location {
  background: #fff0b8;
}

.tool-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
}

.tool-icon-text {
  color: #30327b;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1;
}

.tool-title {
  display: block;
  margin-top: 22rpx;
  color: #30327b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.tool-desc {
  display: block;
  margin-top: 10rpx;
  color: #676787;
  font-size: 21rpx;
  line-height: 1.45;
}

.tool-open {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 14rpx;
  color: #5c5c91;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}

.tool-open-arrow {
  margin-left: 8rpx;
  font-size: 26rpx;
}

.home-footer {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx 2rpx;
}

.footer-line {
  width: 32rpx;
  height: 3rpx;
  margin-right: 12rpx;
  border-radius: 99rpx;
  background: #b7b0dd;
}

.footer-text {
  color: #9b96b5;
  font-size: 21rpx;
  line-height: 1.4;
}
