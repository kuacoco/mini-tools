page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f5ff;
}

.home-scroll {
  flex: 1;
  min-height: 0;
}

.home-page {
  position: relative;
  min-height: 100%;
  overflow: hidden;
  padding: 20rpx 24rpx calc(60rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f7f5ff 0%, #fafaff 48%, #f3f5fa 100%);
  box-sizing: border-box;
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  opacity: 0.42;
  pointer-events: none;
}

.page-glow--left {
  top: -250rpx;
  left: -230rpx;
  background: radial-gradient(circle, rgba(202, 187, 255, 0.74), rgba(202, 187, 255, 0));
}

.page-glow--right {
  top: 500rpx;
  right: -260rpx;
  background: radial-gradient(circle, rgba(255, 193, 213, 0.56), rgba(255, 193, 213, 0));
}

.tool-section-intro {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 172rpx;
  margin-bottom: 22rpx;
  padding: 25rpx 27rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(247, 243, 255, 0.94));
  box-shadow: 0 16rpx 42rpx rgba(75, 62, 119, 0.1);
  box-sizing: border-box;
}

.intro-orbit {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.intro-orbit--top {
  top: -108rpx;
  right: -55rpx;
  width: 245rpx;
  height: 245rpx;
  background: linear-gradient(135deg, rgba(190, 170, 248, 0.2), rgba(250, 191, 217, 0.1));
}

.intro-orbit--bottom {
  right: 172rpx;
  bottom: -116rpx;
  width: 180rpx;
  height: 180rpx;
  border: 29rpx solid rgba(117, 100, 183, 0.045);
  box-sizing: border-box;
}

.tool-section-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.tool-section-kicker {
  margin-bottom: 5rpx;
  color: #9486c4;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.tool-section-title {
  color: #393a52;
  font-size: 37rpx;
  font-weight: 780;
  line-height: 1.18;
}

.tool-section-meta {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
  color: #9692a7;
  font-size: 19rpx;
}

.tool-section-meta-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #8b78cd;
  box-shadow: 0 0 0 5rpx rgba(139, 120, 205, 0.1);
}

.tool-capability-list {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
}

.tool-capability {
  margin-right: 8rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 650;
  line-height: 1;
}

.tool-capability--pink {
  color: #c65f79;
  background: rgba(247, 188, 203, 0.32);
}

.tool-capability--yellow {
  color: #b68324;
  background: rgba(248, 207, 116, 0.32);
}

.tool-capability--blue {
  color: #527fac;
  background: rgba(173, 210, 245, 0.34);
}

.tool-capability--green {
  color: #388d7e;
  background: rgba(161, 221, 207, 0.32);
}

.toolbox-mark-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 122rpx;
  align-items: center;
  justify-content: center;
  width: 122rpx;
  height: 122rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.34);
}

.toolbox-mark {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 30rpx;
  background: rgba(242, 239, 252, 0.8);
  box-shadow: 0 12rpx 28rpx rgba(75, 62, 119, 0.14);
  box-sizing: border-box;
  transform: rotate(4deg);
}

.toolbox-square {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
}

.toolbox-square:nth-child(1) { top: 13rpx; left: 13rpx; }
.toolbox-square:nth-child(2) { top: 13rpx; right: 13rpx; }
.toolbox-square:nth-child(3) { bottom: 13rpx; left: 13rpx; }
.toolbox-square:nth-child(4) { right: 13rpx; bottom: 13rpx; }
.toolbox-square--pink { background: #f17391; }
.toolbox-square--yellow { background: #f5b83e; }
.toolbox-square--blue { background: #55a6e9; }
.toolbox-square--purple { background: #9274ef; }

.tool-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.tool-group {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
}

.tool-group--feidee {
  margin-top: 86rpx;
  margin-bottom: 40rpx;
  padding: 26rpx 18rpx 10rpx;
  border: 1rpx solid #e6e0ff;
  border-radius: 0 30rpx 30rpx 30rpx;
  background: linear-gradient(155deg, #f0ecff, #faf8ff);
  box-shadow: 0 14rpx 28rpx rgba(68, 55, 108, 0.08);
}

.folder-tab {
  position: absolute;
  bottom: 100%;
  left: -1rpx;
  display: flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 32rpx 0 24rpx;
  border: 1rpx solid #e6e0ff;
  border-bottom: 0;
  border-radius: 22rpx 30rpx 0 0;
  background: #f0ecff;
  color: #30327b;
  font-size: 29rpx;
  font-weight: 700;
}

.folder-tab-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #8c83d7;
}

.tool-grid--feidee .tool-item {
  border-radius: 22rpx;
  box-shadow: 0 5rpx 0 rgba(255, 255, 255, 0.85), 0 10rpx 16rpx rgba(68, 55, 108, 0.05);
}

.tool-item {
  position: relative;
  display: flex;
  width: calc((100% - 18rpx) / 2);
  min-height: 210rpx;
  margin-bottom: 18rpx;
  padding: 25rpx 23rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(68, 55, 108, 0.07);
  flex-direction: column;
  box-sizing: border-box;
  animation: tool-card-in 480ms cubic-bezier(0.22, 0.72, 0.28, 1) backwards;
  transition: transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
}

.tool-item::after {
  position: absolute;
  right: -42rpx;
  bottom: -58rpx;
  width: 150rpx;
  height: 150rpx;
  border: 24rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  box-sizing: border-box;
  content: '';
  pointer-events: none;
  transition: transform 220ms ease;
}

.tool-item--active {
  opacity: 0.84;
  transform: scale(0.975);
  box-shadow: 0 7rpx 18rpx rgba(68, 55, 108, 0.08);
}

.tool-item--active::after { transform: translate(-5rpx, -4rpx) scale(1.06); }

.tool-item:nth-child(1) { animation-delay: 30ms; }
.tool-item:nth-child(2) { animation-delay: 85ms; }
.tool-item:nth-child(3) { animation-delay: 140ms; }
.tool-item:nth-child(4) { animation-delay: 195ms; }
.tool-item:nth-child(5) { animation-delay: 250ms; }
.tool-item:nth-child(6) { animation-delay: 305ms; }
.tool-item:nth-child(7) { animation-delay: 360ms; }

.tool-grid--feidee .tool-item:nth-child(1),
.tool-grid--feidee .tool-item:nth-child(4) { width: calc(54% - 9rpx); }
.tool-grid--feidee .tool-item:nth-child(2),
.tool-grid--feidee .tool-item:nth-child(3) { width: calc(46% - 9rpx); }
.tool-grid--life .tool-item:nth-child(1) { width: calc(54% - 9rpx); }
.tool-grid--life .tool-item:nth-child(2) { width: calc(46% - 9rpx); }

.tool-item--spending-calendar { background: linear-gradient(145deg, #ffdce6, #fff1f5); }
.tool-item--spending-bill { background: linear-gradient(145deg, #ece4ff, #f8f4ff); }
.tool-item--category-expense { background: linear-gradient(145deg, #d4f0f5, #eefbfc); }
.tool-item--budget { background: linear-gradient(145deg, #ffe9b8, #fff7df); }
.tool-item--course { background: linear-gradient(145deg, #dcecff, #f0f6ff); }
.tool-item--qing-calendar { background: linear-gradient(145deg, #d8f6ef, #effcf9); }
.tool-item--location { background: linear-gradient(145deg, #f3dff9, #fbf1ff); }

.tool-card-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tool-title {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
  color: #393a52;
  font-size: 29rpx;
  font-weight: 780;
  line-height: 1.3;
}

.tool-open {
  display: flex;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.64);
  box-sizing: border-box;
}

.tool-open-arrow {
  display: block;
  width: 18rpx;
  height: 18rpx;
  transition: transform 180ms ease;
}

.tool-item--active .tool-open-arrow { transform: translateX(3rpx); }

.tool-desc {
  position: relative;
  z-index: 1;
  display: -webkit-box;
  margin-top: 13rpx;
  overflow: hidden;
  color: #77778f;
  font-size: 20rpx;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tool-card-mark {
  position: relative;
  z-index: 1;
  width: 62rpx;
  height: 6rpx;
  margin-top: auto;
  padding-top: 16rpx;
}

.tool-card-mark::before,
.tool-card-mark-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 6rpx;
  border-radius: 999rpx;
}

.tool-card-mark::before {
  width: 62rpx;
  background: rgba(255, 255, 255, 0.68);
  content: '';
}

.tool-card-mark-fill {
  width: 34rpx;
  background: #ee7895;
  transition: width 220ms ease;
}

.tool-item--active .tool-card-mark-fill { width: 62rpx; }

.tool-item--spending-bill .tool-card-mark-fill { background: #967ce7; }
.tool-item--category-expense .tool-card-mark-fill { background: #55b4c4; }
.tool-item--budget .tool-card-mark-fill { background: #efb740; }
.tool-item--course .tool-card-mark-fill { background: #62a6e9; }
.tool-item--qing-calendar .tool-card-mark-fill { background: #42bea8; }
.tool-item--location .tool-card-mark-fill { background: #c477d6; }

.home-footer-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  padding: 22rpx 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 27rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(242, 238, 252, 0.78));
  box-shadow: 0 10rpx 28rpx rgba(68, 55, 108, 0.06);
  animation: tool-card-in 480ms 360ms cubic-bezier(0.22, 0.72, 0.28, 1) backwards;
}

.footer-color-stack {
  position: relative;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 52rpx;
  margin-right: 19rpx;
}

.footer-color {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 11rpx;
  box-sizing: border-box;
}

.footer-color--pink {
  top: 0;
  left: 0;
  background: #f27a96;
}

.footer-color--yellow {
  top: 2rpx;
  right: 0;
  background: #f2b83f;
}

.footer-color--blue {
  bottom: 0;
  left: 14rpx;
  background: #5ba8e8;
}

.footer-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.footer-kicker {
  color: #9a8dc5;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.footer-title {
  margin-top: 7rpx;
  color: #5b5b70;
  font-size: 19rpx;
  line-height: 1.35;
}

.footer-spark {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: #8b78cd;
  font-size: 28rpx;
  transform: rotate(8deg);
}

@keyframes tool-card-in {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.975);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
