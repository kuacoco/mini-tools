/* ---------- 可爱清新风格：马卡龙薄荷 + 淡粉 + 淡紫 ---------- */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.course-page {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  background: linear-gradient(
    180deg,
    #f0fdf9 0%,
    #ecfeff 40%,
    #fdf2f8 80%,
    #ffffff 100%
  );
  box-sizing: border-box;
}

.nav-title-trigger {
  display: inline-flex;
  align-items: center;
  max-width: 420rpx;
}

.nav-title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #475569;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-title-arrow {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #94a3b8;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}

.nav-title-arrow.is-open {
  transform: rotate(180deg);
}

.record-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(15, 23, 42, 0.06);
}

.record-dropdown-panel {
  margin-top: 184rpx;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 0;
  width: calc(100% - 112rpx);
  max-width: 520rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 44rpx rgba(15, 23, 42, 0.14);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-sizing: border-box;
}

.record-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.65);
}

.record-option:last-child {
  border-bottom: none;
}

.record-option.active {
  background: rgba(45, 212, 191, 0.12);
}

.record-option-title {
  font-size: 28rpx;
  color: #475569;
  flex: 1;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-option-delete {
  font-size: 24rpx;
  color: #ef4444;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.12);
}

.month-swiper {
  height: 100%;
  min-height: 0;
}

.month-content {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.top-placeholder {
  height: 28rpx;
}

.bottom-placeholder {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

.empty-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 56rpx 28rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 28rpx rgba(45, 212, 191, 0.06);
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #5d5d6b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

.swipe-row {
  position: relative;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.swipe-action {
  position: absolute;
  top: 0;
  width: 164rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.swipe-action.edit {
  left: 0;
  background: linear-gradient(145deg, #67e8f9 0%, #22d3ee 100%);
}

.swipe-action.delete {
  right: 0;
  background: linear-gradient(145deg, #f9a8d4 0%, #f472b6 100%);
}

.course-item {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow:
    0 8rpx 28rpx rgba(45, 212, 191, 0.06),
    0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  transition: transform 0.18s ease;
}

