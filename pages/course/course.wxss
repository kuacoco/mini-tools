page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.course-page {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #f7f5ff 0%, #f8f9fd 46%, #f3f5fa 100%);
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.46;
}

.page-glow--left {
  top: -230rpx;
  left: -230rpx;
  background: radial-gradient(circle, rgba(194, 180, 255, 0.76), rgba(194, 180, 255, 0));
}

.page-glow--right {
  top: 390rpx;
  right: -250rpx;
  background: radial-gradient(circle, rgba(255, 192, 211, 0.64), rgba(255, 192, 211, 0));
}

.nav-title-trigger {
  display: inline-flex;
  align-items: center;
  max-width: 430rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.nav-title-text {
  max-width: 360rpx;
  overflow: hidden;
  color: #30314a;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-title-arrow {
  margin-left: 10rpx;
  color: #8179a9;
  font-size: 24rpx;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}

.nav-title-arrow.is-open {
  transform: rotate(180deg);
}

.record-dropdown-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding-top: 184rpx;
  background: rgba(35, 31, 56, 0.2);
  backdrop-filter: blur(6rpx);
  box-sizing: border-box;
}

.record-dropdown-panel {
  width: calc(100% - 96rpx);
  max-width: 560rpx;
  margin: 0 auto;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 22rpx 62rpx rgba(54, 45, 91, 0.2);
}

.record-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(121, 111, 164, 0.1);
}

.record-option:last-child {
  border-bottom: none;
}

.record-option.active {
  background: linear-gradient(90deg, rgba(118, 101, 183, 0.13), rgba(118, 101, 183, 0.03));
}

.record-option-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #47485f;
  font-size: 28rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-option.active .record-option-title {
  color: #665aa7;
  font-weight: 650;
}

.record-option-delete {
  margin-left: 16rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0f3;
  color: #d7667d;
  font-size: 22rpx;
}

.month-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.top-placeholder { height: 20rpx; }

.bottom-placeholder {
  height: calc(142rpx + constant(safe-area-inset-bottom));
  height: calc(142rpx + env(safe-area-inset-bottom));
}

.course-list-content { padding-top: 8rpx; }

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}

.section-heading-copy {
  display: flex;
  flex-direction: column;
}

.section-kicker {
  margin-bottom: 5rpx;
  color: #8c80bd;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.section-title {
  color: #35364d;
  font-size: 34rpx;
  font-weight: 700;
}

.section-count {
  display: flex;
  align-items: baseline;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(117, 101, 179, 0.1);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.section-count-value {
  color: #665aa7;
  font-size: 27rpx;
  font-weight: 700;
}

.section-count-unit {
  margin-left: 5rpx;
  color: #9393a7;
  font-size: 21rpx;
}

.empty-card {
  padding: 58rpx 28rpx 62rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 44rpx rgba(68, 57, 108, 0.08);
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #7667b8, #9a86d6);
  box-shadow: 0 12rpx 26rpx rgba(111, 94, 177, 0.24);
  color: #fff;
  font-size: 40rpx;
  font-weight: 300;
}

.empty-title {
  display: block;
  margin-bottom: 10rpx;
  color: #47485e;
  font-size: 29rpx;
  font-weight: 650;
}

.empty-desc {
  color: #999aac;
  font-size: 23rpx;
}

.swipe-row {
  position: relative;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 28rpx;
}

.swipe-action {
  position: absolute;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 100%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 650;
}

.swipe-action.edit {
  left: 0;
  background: linear-gradient(145deg, #7e70bd, #a18dd8);
}

.swipe-action.delete {
  right: 0;
  background: linear-gradient(145deg, #ef90a5, #dc6f89);
}

.course-item {
  position: relative;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 13rpx 36rpx rgba(66, 55, 107, 0.085);
  transition: transform 0.18s ease;
}

.course-item::after {
  position: absolute;
  top: 24rpx;
  right: -34rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(122, 105, 187, 0.035);
  content: "";
  pointer-events: none;
}

.course-item--checked {
  background: linear-gradient(145deg, #fff, #f6f4ff);
}

.item-row {
  display: flex;
  align-items: flex-start;
}

.course-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 29rpx;
  box-shadow: 0 9rpx 20rpx rgba(60, 53, 88, 0.14);
  box-sizing: border-box;
  transition: transform 0.2s ease;
}

.course-avatar:active { transform: scale(0.94); }
.course-avatar.checked { border-radius: 50%; }

.avatar-char,
.avatar-check {
  color: #fff;
  font-weight: 700;
  text-shadow: 0 2rpx 7rpx rgba(40, 35, 67, 0.22);
}

.avatar-char { font-size: 36rpx; }
.avatar-check { font-size: 39rpx; }

.item-info {
  flex: 1;
  min-width: 0;
}

.item-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.item-title-block {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding-right: 16rpx;
}

.item-name {
  overflow: hidden;
  color: #38394f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-status {
  margin-top: 8rpx;
  color: #9a9bad;
  font-size: 21rpx;
}

.course-item--checked .item-status { color: #7467b2; }

.remain-pill {
  display: flex;
  flex-shrink: 0;
  align-items: baseline;
  padding: 9rpx 13rpx;
  border-radius: 16rpx;
  background: #f4f1ff;
}

.remain-label {
  color: #9993b0;
  font-size: 19rpx;
}

.remain-value {
  margin-left: 6rpx;
  color: #665aa7;
  font-size: 26rpx;
  font-weight: 700;
}

.course-stats {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.course-stat {
  display: flex;
  align-items: baseline;
}

.course-stat-label {
  color: #9a9bac;
  font-size: 20rpx;
}

.course-stat-value {
  margin-left: 8rpx;
  color: #4a4b61;
  font-size: 26rpx;
  font-weight: 700;
}

.course-stat-divider {
  width: 1rpx;
  height: 22rpx;
  margin: 0 16rpx;
  background: #e5e3ed;
}

.progress-percent {
  margin-left: auto;
  color: #85869a;
  font-size: 22rpx;
  font-weight: 600;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.25s ease-out;
}

.fab-wrap {
  position: fixed;
  z-index: 997;
  right: 34rpx;
  bottom: calc(34rpx + constant(safe-area-inset-bottom));
  bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 31rpx;
  background: linear-gradient(145deg, #6f61ad, #9783d3);
  box-shadow: 0 15rpx 34rpx rgba(92, 74, 160, 0.36);
  box-sizing: border-box;
  transition: transform 0.16s ease;
}

.add-btn:active { transform: scale(0.94); }

.add-btn-icon {
  width: 38rpx;
  height: 38rpx;
}

.popup-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 31, 56, 0.32);
  backdrop-filter: blur(8rpx);
}

.popup-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 38rpx 38rpx 0 0;
  background: linear-gradient(180deg, #fbfaff 0%, #f6f6fb 100%);
  box-shadow: 0 -18rpx 58rpx rgba(55, 46, 91, 0.18);
  box-sizing: border-box;
  transform-origin: bottom center;
}

.popup-mask.is-entering { animation: maskFadeIn 220ms ease-out forwards; }
.popup-mask.is-entering .popup-sheet { animation: sheetSlideUp 280ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.popup-mask.is-leaving { animation: maskFadeOut 220ms ease-out forwards; }
.popup-mask.is-leaving .popup-sheet { animation: sheetSlideDown 240ms cubic-bezier(0.4, 0, 0.2, 1) forwards; }

@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetSlideUp {
  from { opacity: 0; transform: translateY(60rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes maskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes sheetSlideDown {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(60rpx); }
}

.popup-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 18rpx auto 16rpx;
  border-radius: 999rpx;
  background: #d7d1e8;
}

.popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(121, 111, 164, 0.1);
}

.popup-title-wrap {
  display: flex;
  flex-direction: column;
}

.popup-kicker {
  margin-bottom: 5rpx;
  color: #9689c5;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.popup-title {
  color: #35364d;
  font-size: 35rpx;
  font-weight: 700;
}

.popup-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid rgba(121, 111, 164, 0.1);
  border-radius: 20rpx;
  background: #f0edf8;
}

.popup-close-icon {
  width: 36rpx;
  height: 36rpx;
}

.popup-body { padding: 28rpx 0 24rpx; }
.popup-field { margin-bottom: 28rpx; }
.popup-field:last-of-type { margin-bottom: 0; }

.popup-label {
  display: block;
  margin-bottom: 12rpx;
  color: #696a7d;
  font-size: 25rpx;
  font-weight: 600;
}

.popup-input,
.stepper-row {
  width: 100%;
  height: 96rpx;
  border: 2rpx solid #e5e1f0;
  border-radius: 20rpx;
  background: #fff;
  box-sizing: border-box;
}

.popup-input {
  padding: 0 24rpx;
  color: #45465c;
  font-size: 29rpx;
}

.stepper-row {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.stepper-btn {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 100%;
  background: #f2eff9;
  color: #695bab;
  font-size: 38rpx;
}

.stepper-btn:active { background: #e8e2f5; }
.stepper-btn.disabled { color: #c1bbd4; }

.stepper-input {
  flex: 1;
  height: 100%;
  padding: 0 16rpx;
  background: transparent;
  color: #45465c;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.popup-footer { padding-top: 24rpx; }

.popup-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.popup-btn.primary {
  background: linear-gradient(145deg, #6e60ad, #9783d3);
  box-shadow: 0 12rpx 28rpx rgba(95, 77, 162, 0.3);
  color: #fff;
}

.popup-btn.primary:active { transform: scale(0.985); }

.share-nick-mask {
  position: fixed;
  z-index: 1300;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(35, 31, 56, 0.38);
  backdrop-filter: blur(8rpx);
  box-sizing: border-box;
}

.share-nick-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 38rpx 32rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  background: linear-gradient(155deg, #fff, #f7f5ff);
  box-shadow: 0 26rpx 68rpx rgba(47, 39, 77, 0.22);
}

.share-nick-title {
  display: block;
  margin-bottom: 10rpx;
  color: #37384e;
  font-size: 33rpx;
  font-weight: 700;
}

.share-nick-hint {
  display: block;
  margin-bottom: 26rpx;
  color: #9697a9;
  font-size: 23rpx;
  line-height: 1.5;
}

.share-nick-input {
  width: 100%;
  height: 94rpx;
  margin-bottom: 28rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e5e1f0;
  border-radius: 20rpx;
  background: #fff;
  color: #45465c;
  font-size: 28rpx;
  box-sizing: border-box;
}

.share-nick-actions {
  display: flex;
  align-items: center;
}

.share-nick-btn + .share-nick-btn { margin-left: 18rpx; }

.share-nick-btn {
  flex: 1;
  height: 86rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 86rpx;
  text-align: center;
}

.share-nick-btn--ghost {
  background: #eeedf4;
  color: #747589;
}

.share-nick-btn--primary {
  background: linear-gradient(145deg, #6e60ad, #9783d3);
  box-shadow: 0 9rpx 22rpx rgba(95, 77, 162, 0.25);
  color: #fff;
}
