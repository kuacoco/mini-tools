<navigation-bar title="" home-url="/pages/index/index">
	<view slot="center" class="nav-title-trigger" bindtap="onToggleRecordDropdown">
		<text class="nav-title-text">{{ navTitle }}</text>
		<text class="nav-title-arrow {{ showRecordDropdown ? 'is-open' : '' }}">▾</text>
	</view>
</navigation-bar>
<view class="course-page">
	<view wx:if="{{ showRecordDropdown }}" class="record-dropdown-mask" bindtap="onCloseRecordDropdown">
		<view class="record-dropdown-panel" catchtap="noop">
			<view class="record-option {{ !isViewerMode ? 'active' : '' }}" data-type="self" bindtap="onSelectRecordOption">
				<text class="record-option-title">我的消课记录</text>
			</view>
			<view
				wx:for="{{ recentShareRecords }}"
				wx:key="token"
				class="record-option {{ isViewerMode && shareToken === item.token ? 'active' : '' }}"
				data-type="share"
				data-token="{{ item.token }}"
				bindtap="onSelectRecordOption"
			>
				<text class="record-option-title">{{ item.displayTitle }}</text>
				<view class="record-option-delete" data-token="{{ item.token }}" catchtap="onDeleteRecordOption">删除</view>
			</view>
		</view>
	</view>
	<scroll-view class="month-content" scroll-y="true" enhanced show-scrollbar="{{ false }}">
		<view class="top-placeholder"></view>
		<checkin-calendar
			week-days="{{ weekDays }}"
			month-picker-items="{{ monthPickerItems }}"
			current-picker-index="{{ currentPickerIndex }}"
			current-month-label="{{ currentMonthLabel }}"
			calendar-days-swipe="{{ calendarDaysSwipe }}"
			swiper-month-index="{{ swiperMonthIndex }}"
			swiper-remount-key="{{ calendarSwiperKey }}"
			selected-date="{{ selectedDate }}"
			today-date-string="{{ todayDateString }}"
			selected-date-display="{{ selectedDateDisplay }}"
			bind:swipeprev="onPrevMonth"
			bind:swipenext="onNextMonth"
			bind:selectmonth="onSelectMonth"
			bind:selectdate="onSelectDate"
			bind:gotoday="goToToday"
		/>

		<view class="course-list-content">
			<view wx:if="{{ !courseList.length }}" class="empty-card">
				<text class="empty-title">{{ isViewerMode ? '对方暂无课程' : '还没有添加课程' }}</text>
				<text class="empty-desc" wx:if="{{ !isViewerMode }}">点击下方 + 添加第一个课程</text>
			</view>

			<view wx:for="{{ courseList }}" wx:key="id" class="swipe-row">
				<block wx:if="{{ !isViewerMode }}">
					<view class="swipe-action edit" data-id="{{ item.id }}" catchtap="onEditCourseAction">编辑</view>
					<view class="swipe-action delete" data-id="{{ item.id }}" catchtap="onDeleteCourseAction">删除</view>
				</block>
				<view
					class="course-item {{ item.checkedToday ? 'course-item--checked' : '' }}"
					style="transform: translateX({{ item.offsetX }}px);"
					data-id="{{ item.id }}"
					catchtap="onCourseTap"
					bindtouchstart="onItemTouchStart"
					bindtouchmove="onItemTouchMove"
					bindtouchend="onItemTouchEnd"
					bindtouchcancel="onItemTouchEnd"
				>
					<view class="item-row">
						<block wx:if="{{ isViewerMode }}">
							<view class="course-avatar {{ item.checkedToday ? 'checked' : '' }}" style="background: {{ item.avatarColor }}">
								<text wx:if="{{ !item.checkedToday }}" class="avatar-char">{{ item.firstChar }}</text>
								<text wx:else class="avatar-check">✓</text>
							</view>
						</block>
						<block wx:else>
							<view
								class="course-avatar {{ item.checkedToday ? 'checked' : '' }}"
								style="background: {{ item.avatarColor }}"
								data-id="{{ item.id }}"
								catchtap="onToggleCheckin"
							>
								<text wx:if="{{ !item.checkedToday }}" class="avatar-char">{{ item.firstChar }}</text>
								<text wx:else class="avatar-check">✓</text>
							</view>
						</block>
						<view class="item-info">
							<view class="item-header">
								<view class="item-used-row">
									<text class="item-name">{{ item.courseName }}</text>
									<text class="item-used">{{ item.usedClasses }}/{{ item.totalClasses }}</text>
								</view>
								<text class="item-subtitle">剩余 {{ item.remainClasses }} 课时</text>
							</view>
							<view class="progress-track" style="background: {{ item.trackColor }}">
								<view class="progress-fill" style="width: {{ item.barWidth }}; background: {{ item.barColor }}"></view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
		<view class="bottom-placeholder"></view>
	</scroll-view>

	<view wx:if="{{ !isViewerMode && courseList.length < 10 }}" class="fab-wrap">
		<view class="add-btn" bindtap="onOpenAddPopup">
			<image class="add-btn-icon" src="/pages/statics/plus.svg" mode="aspectFit" />
		</view>
	</view>

	<view wx:if="{{ showAddPopup }}" class="popup-mask {{ addPopupClosing ? 'is-leaving' : 'is-entering' }}" bindtap="onClosePopup">
		<view class="popup-sheet" catchtap="noop">
			<view class="popup-handle"></view>
			<view class="popup-head">
				<text class="popup-title">{{ addPopupTitle }}</text>
				<view class="popup-close" bindtap="onClosePopup">
					<image class="popup-close-icon" src="/pages/statics/close.svg" mode="aspectFit" />
				</view>
			</view>
			<view class="popup-body">
				<view class="popup-field">
					<text class="popup-label">课程名称</text>
					<input class="popup-input" placeholder="例如：舞蹈课、钢琴课" maxlength="20" value="{{ addCourseName }}" bindinput="onCourseNameInput" />
				</view>
				<view class="popup-field">
					<text class="popup-label">课时总数</text>
					<view class="stepper-row">
						<view class="stepper-btn minus {{ addTotalClasses <= 1 ? 'disabled' : '' }}" bindtap="onStepperMinus">－</view>
						<input class="stepper-input" type="number" maxlength="3" value="{{ addTotalClasses }}" bindinput="onTotalClassesInput" />
						<view class="stepper-btn plus {{ addTotalClasses >= 999 ? 'disabled' : '' }}" bindtap="onStepperPlus">＋</view>
					</view>
				</view>
			</view>
			<view class="popup-footer">
				<view class="popup-btn primary" bindtap="onSaveCourse">{{ addPopupMode === 'edit' ? '保存' : '添加课程' }}</view>
			</view>
		</view>
	</view>

	<view wx:if="{{ showShareNickPopup }}" class="share-nick-mask" bindtap="onCancelShareNick">
		<view class="share-nick-dialog" catchtap="noop">
			<text class="share-nick-title">分享展示名称</text>
			<text class="share-nick-hint">仅用于生成分享链接，不会写入账号资料</text>
			<input class="share-nick-input" placeholder="选填，留空则不展示昵称" maxlength="16" value="{{ shareNickInputValue }}" bindinput="onShareNickInput" type="nickname" />
			<view class="share-nick-actions">
				<view class="share-nick-btn share-nick-btn--ghost" bindtap="onCancelShareNick">取消</view>
				<view class="share-nick-btn share-nick-btn--primary" bindtap="onConfirmShareNick">确定</view>
			</view>
		</view>
	</view>
</view>
