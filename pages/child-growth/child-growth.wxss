page { height: 100vh; display: flex; flex-direction: column; background: #F7F5FF; }
.growth-page { flex: 1; min-height: 0; position: relative; color: #393A52; background: linear-gradient(180deg, #F7F5FF, #F9FAF8); }
.growth-scroll { height: 100%; min-height: 0; }
.growth-content { padding: 22rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.growth-page button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font: inherit; line-height: 1.4; text-align: left; cursor: pointer; }
.growth-page button::after { border: 0; }
.growth-page button[disabled] { opacity: .45; cursor: default; }
.growth-page button:focus-visible, .growth-page input:focus-visible { outline: 3rpx solid #8172B2; outline-offset: 4rpx; }
.is-pressed { opacity: .65; }
.opening-line { margin: 8rpx 4rpx 22rpx; }
.page-eyebrow, .section-kicker { display: block; color: #75668C; font-size: 17rpx; letter-spacing: 2rpx; font-weight: 600; line-height: 1.5; }
.opening-note { display: block; margin-top: 8rpx; color: #6F6B80; font-size: 24rpx; }
.child-bar { display: flex; align-items: center; margin-bottom: 24rpx; }
.child-scroll { flex: 1; width: 0; white-space: nowrap; }
.child-tabs { display: flex; align-items: center; }
.growth-page .child-tab { display: inline-block; flex-shrink: 0; margin-right: 12rpx; padding: 15rpx 26rpx; border: 1rpx solid #E8E3F0; border-radius: 999rpx; color: #6F6B80; background: #FFFFFF; font-size: 25rpx; }
.growth-page .child-tab.is-selected { background: #EAE4F7; border-color: #D7CBE9; color: #645181; font-weight: 650; }
.growth-page .add-child { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-left: 12rpx; border: 1rpx dashed #C5B7D9; border-radius: 50%; color: #77618F; font-size: 35rpx; }
.child-overview, .chart-card { border: 1rpx solid #ECE8F1; border-radius: 30rpx; background: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(68,55,108,.035); }
.child-overview { padding: 28rpx; }
.child-identity { display: flex; align-items: center; }
.child-avatar { position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 28rpx; background: #ECE6F6; color: #77618F; font-size: 36rpx; font-weight: 650; }
.avatar-spark { position: absolute; right: -8rpx; bottom: -6rpx; color: #C57C66; font-size: 26rpx; }
.child-description { flex: 1; min-width: 0; margin-left: 20rpx; }
.child-name { display: block; color: #393A52; font-size: 29rpx; font-weight: 650; word-break: break-all; }
.child-age { display: block; margin-top: 6rpx; color: #6F6B80; font-size: 20rpx; line-height: 1.6; }
.growth-page .text-button { padding: 16rpx 0 16rpx 14rpx; color: #77618F; font-size: 23rpx; flex-shrink: 0; }
.latest-heading { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 16rpx; color: #6F6B80; font-size: 20rpx; }
.latest-metrics { display: flex; }
.latest-metric { flex: 1; min-width: 0; padding: 22rpx; border-radius: 20rpx; }
.latest-metric + .latest-metric { margin-left: 14rpx; }
.height-tone { background: #EDF5F0; color: #3E6F64; }
.weight-tone { background: #FBF0E8; color: #A55D48; }
.metric-caption { display: block; font-size: 21rpx; font-weight: 600; }
.latest-number { margin-top: 10rpx; font-size: 55rpx; letter-spacing: -1rpx; font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; line-height: 1.15; }
.number-unit { margin-left: 8rpx; font-size: 22rpx; font-weight: 400; letter-spacing: 0; }
.metric-position { display: block; margin-top: 12rpx; font-size: 20rpx; line-height: 1.5; }
.growth-page .primary-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #7C6A9D; color: #FFFFFF; font-size: 27rpx; font-weight: 600; box-sizing: border-box; }
.growth-page .record-button { justify-content: space-between; margin-top: 22rpx; }
.button-detail { margin-left: 12rpx; font-size: 19rpx; color: #F0E9FA; font-weight: 400; }
.chart-card { margin-top: 26rpx; padding: 28rpx 24rpx 20rpx; }
.section-heading, .timeline-heading { display: flex; justify-content: space-between; align-items: center; }
.section-title { display: block; margin-top: 8rpx; color: #393A52; font-size: 30rpx; font-weight: 650; letter-spacing: 1rpx; }
.growth-page .source-link { flex-shrink: 0; margin-left: 8rpx; padding: 16rpx 0 16rpx 10rpx; color: #6F6B80; font-size: 20rpx; }
.chart-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; }
.metric-switch { display: flex; padding: 5rpx; border-radius: 16rpx; background: #F3F1F7; }
.growth-page .metric-option { min-width: 84rpx; padding: 12rpx 14rpx; border-radius: 12rpx; color: #6F6B80; font-size: 23rpx; text-align: center; }
.growth-page .metric-option.active { background: #FFFFFF; box-shadow: 0 2rpx 6rpx rgba(68,55,108,.06); font-weight: 650; }
.growth-page .height-active { color: #3E6F64; }
.growth-page .weight-active { color: #A55D48; }
.range-switch { display: flex; align-items: center; }
.growth-page .range-option { margin-left: 6rpx; padding: 12rpx 10rpx; border-radius: 12rpx; color: #6F6B80; font-size: 21rpx; }
.growth-page .range-active { color: #77618F; background: #F0ECF7; font-weight: 600; }
.chart-legend { display: flex; flex-wrap: wrap; align-items: center; margin: 18rpx 0 12rpx; }
.legend-item { display: flex; align-items: center; margin: 0 18rpx 8rpx 0; color: #6F6B80; font-size: 18rpx; }
.legend-band { width: 24rpx; height: 15rpx; margin-right: 7rpx; border-radius: 4rpx; background: #D4E8DC; }
.legend-band--weight { background: #F0D8C9; }
.legend-line { width: 24rpx; height: 0; margin-right: 7rpx; border-top: 2rpx dashed #6F6B80; }
.legend-dot { width: 10rpx; height: 10rpx; margin-right: 7rpx; border: 3rpx solid #4D8278; border-radius: 50%; }
.legend-dot--weight { border-color: #C57C66; }
.chart-scope-note { display: block; margin: 10rpx 0; color: #6F6B80; font-size: 20rpx; line-height: 1.5; }
.reference-caption { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #F0EDF4; }
.reference-caption text { display: block; color: #6F6B80; font-size: 19rpx; line-height: 1.7; }
.timeline-heading { margin: 36rpx 4rpx 24rpx; }
.record-count { align-self: flex-end; color: #6F6B80; font-size: 22rpx; padding-bottom: 2rpx; }
.timeline { position: relative; }
.timeline-year { display: flex; align-items: center; margin: 26rpx 0 22rpx 134rpx; font-size: 30rpx; color: #645181; font-weight: 650; }
.year-dot { width: 14rpx; height: 14rpx; margin-left: -12rpx; margin-right: 26rpx; border-radius: 50%; background: #B6A8CC; box-shadow: 0 0 0 8rpx #F0ECF7; }
.year-caption { margin-left: 14rpx; color: #6F6B80; font-size: 20rpx; font-weight: 400; }
.timeline-row { position: relative; display: flex; padding-bottom: 22rpx; }
.timeline-row::before { position: absolute; left: 128rpx; top: 0; bottom: 0; width: 2rpx; background: #DFD7EB; content: ''; }
.timeline-date { width: 108rpx; flex-shrink: 0; padding-top: 18rpx; text-align: right; }
.timeline-day { display: block; color: #645181; font-size: 28rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.timeline-age { display: block; margin-top: 6rpx; color: #6F6B80; font-size: 18rpx; }
.timeline-node { position: absolute; left: 122rpx; top: 28rpx; width: 10rpx; height: 10rpx; border: 2rpx solid #B6A8CC; border-radius: 50%; background: #F7F5FF; }
.timeline-node--latest { background: #7C6A9D; border-color: #7C6A9D; box-shadow: 0 0 0 6rpx #EBE4F4; }
.growth-page .timeline-entry { flex: 1; min-width: 0; margin-left: 40rpx; padding: 20rpx; border: 1rpx solid #ECE8F1; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(68,55,108,.025); }
.entry-pressed { background: #F4F0FA !important; }
.entry-top { display: flex; align-items: center; justify-content: space-between; }
.entry-caption { color: #75668C; font-size: 18rpx; letter-spacing: 1rpx; }
.entry-edit { color: #6F6B80; font-size: 18rpx; }
.entry-measurements { display: flex; align-items: center; margin: 16rpx 0; }
.entry-measurement { flex: 1; min-width: 0; }
.entry-label { display: block; font-size: 19rpx; }
.height-ink { color: #3E6F64; }
.weight-ink { color: #A55D48; }
.entry-value { display: block; margin-top: 5rpx; color: #48435E; font-size: 37rpx; font-weight: 600; letter-spacing: -1rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.entry-unit { margin-left: 5rpx; color: #6F6B80; font-size: 19rpx; letter-spacing: 0; font-weight: 400; }
.entry-divider { width: 1rpx; height: 52rpx; margin: 0 20rpx 0 12rpx; background: #ECE8F1; }
.entry-change { display: block; padding-top: 13rpx; border-top: 1rpx dashed #E8E2EF; color: #6F6B80; font-size: 18rpx; line-height: 1.6; }
.entry-note { display: block; margin-top: 10rpx; color: #686377; font-size: 21rpx; line-height: 1.6; word-break: break-all; }
.growth-page .load-more { width: 100%; padding: 18rpx; color: #77618F; font-size: 23rpx; text-align: center; }
.timeline-end { display: flex; align-items: center; margin-left: 122rpx; padding: 8rpx 0; color: #6F6B80; font-size: 19rpx; }
.timeline-end view { width: 12rpx; height: 12rpx; margin-right: 24rpx; border-radius: 50%; background: #DFD7EB; }
.growth-footer { display: block; margin: 36rpx 0 10rpx; color: #75668C; font-size: 21rpx; text-align: center; letter-spacing: 3rpx; }
.growth-state, .timeline-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 360rpx; padding: 30rpx; border-radius: 28rpx; background: #FFFFFF; color: #6F6B80; text-align: center; font-size: 24rpx; }
.growth-spinner { width: 36rpx; height: 36rpx; margin-bottom: 20rpx; border: 4rpx solid #EAE4F7; border-top-color: #7C6A9D; border-radius: 50%; }
.state-title { display: block; color: #48435E; font-size: 28rpx; font-weight: 600; }
.state-note { display: block; margin-top: 14rpx; color: #6F6B80; font-size: 23rpx; line-height: 1.7; }
.growth-page .secondary-button { padding: 20rpx 28rpx; margin-top: 26rpx; border: 1rpx solid #D7CBE9; border-radius: 18rpx; color: #77618F; font-size: 24rpx; text-align: center; }
.empty-seed { color: #B5CDBB; font-size: 52rpx; margin-bottom: 20rpx; }
.welcome-card { position: relative; overflow: hidden; padding: 54rpx 30rpx 34rpx; border: 1rpx solid #E5DDED; border-radius: 30rpx; background: linear-gradient(140deg, #F0EAF9, #FFFFFF); }
.welcome-ruler { position: absolute; top: 30rpx; right: 0; width: 54rpx; padding: 14rpx 0; border-left: 1rpx solid #DBCEE8; }
.welcome-ruler view { width: 18rpx; height: 1rpx; margin: 20rpx 0; background: #DBCEE8; }
.welcome-ruler view:nth-child(3n+1) { width: 30rpx; }
.welcome-kicker { display: block; color: #75668C; font-size: 22rpx; letter-spacing: 3rpx; }
.welcome-title { display: block; margin-top: 28rpx; color: #48435E; font-size: 40rpx; font-weight: 600; line-height: 1.7; }
.welcome-title-line { display: block; }
.welcome-copy { display: block; margin: 22rpx 0 40rpx; color: #6F6B80; font-size: 24rpx; line-height: 1.8; }
.welcome-card .primary-button { justify-content: space-between; }
.privacy-note { display: block; margin-top: 22rpx; color: #6F6B80; font-size: 19rpx; text-align: center; }
.sheet-backdrop { position: fixed; z-index: 1000; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: flex-end; background: rgba(44,37,62,.3); }
.growth-sheet { display: flex; flex-direction: column; width: 100%; height: 80vh; padding: 12rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #FCFBFE; box-sizing: border-box; }
.sheet-grip { flex-shrink: 0; align-self: center; width: 62rpx; height: 6rpx; margin: 5rpx 0 24rpx; border-radius: 99rpx; background: #D9D1E5; }
.sheet-heading { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-title { display: block; margin-top: 8rpx; color: #48435E; font-size: 34rpx; font-weight: 650; }
.growth-page .sheet-close { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 50%; background: #F0ECF7; color: #77618F; font-size: 40rpx; }
/* Skyline scroll-view needs a bounded height chain, not an auto-height parent. */
.sheet-body { flex: 1; height: 0; min-height: 0; }
.field-label { display: block; margin: 24rpx 0 12rpx; color: #686377; font-size: 24rpx; font-weight: 600; }
.profile-name-input, .note-input { width: 100%; height: 90rpx; padding: 0 22rpx; border: 1rpx solid #E5DDED; border-radius: 18rpx; background: #FFFFFF; color: #48435E; font-size: 27rpx; box-sizing: border-box; }
.date-field { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; padding: 12rpx 22rpx; border: 1rpx solid #E5DDED; border-radius: 18rpx; background: #FFFFFF; color: #686377; font-size: 26rpx; box-sizing: border-box; }
.date-field-label { margin-right: 18rpx; color: #6F6B80; font-size: 23rpx; }
.sex-options { display: flex; }
.growth-page .sex-option { flex: 1; padding: 20rpx; border: 1rpx solid #E5DDED; border-radius: 18rpx; background: #FFFFFF; color: #6F6B80; font-size: 25rpx; text-align: center; }
.growth-page .sex-option + .sex-option { margin-left: 16rpx; }
.growth-page .sex-selected { background: #EAE4F7; border-color: #BDAAD4; color: #645181; font-weight: 600; }
.form-hint { display: block; margin-top: 16rpx; color: #6F6B80; font-size: 21rpx; line-height: 1.7; }
.record-for { display: flex; justify-content: space-between; margin: 2rpx 0 20rpx; color: #6F6B80; font-size: 22rpx; }
.measurement-fields { display: flex; margin-top: 22rpx; }
.measurement-field { flex: 1; min-width: 0; padding: 22rpx; border-radius: 22rpx; }
.measurement-field + .measurement-field { margin-left: 16rpx; }
.measurement-field .field-label { margin: 0 0 16rpx; color: inherit; font-size: 23rpx; }
.measure-input-row { display: flex; align-items: baseline; }
.measure-input-row input { flex: 1; min-width: 0; width: 0; height: 76rpx; padding: 0; color: inherit; font-size: 53rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.measure-input-row > text { margin-left: 6rpx; font-size: 23rpx; }
.measurement-steps { display: flex; margin-top: 18rpx; }
.growth-page .measurement-steps button { flex: 1; padding: 12rpx 0; border: 1rpx solid rgba(100,105,110,.1); border-radius: 12rpx; background: rgba(255,255,255,.65); color: inherit; font-size: 22rpx; text-align: center; }
.growth-page .measurement-steps button + button { margin-left: 10rpx; }
.optional-label { color: #6F6B80; font-size: 20rpx; font-weight: 400; }
.note-input { font-size: 24rpx; }
.sheet-actions { padding-top: 28rpx; padding-bottom: 8rpx; }
.growth-page .delete-button { display: block; width: 100%; margin-top: 18rpx; padding: 18rpx 0; color: #B65F65; font-size: 24rpx; text-align: center; }
.form-error { display: block; margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #FFF0EF; color: #A25C4A; font-size: 23rpx; line-height: 1.6; }
.source-band-demo { display: flex; align-items: center; margin: 10rpx 0 24rpx; padding: 22rpx; border-radius: 18rpx; background: #EDF5F0; color: #3E6F64; font-size: 24rpx; }
.source-band-demo view { width: 38rpx; height: 26rpx; margin-right: 14rpx; border-radius: 6rpx; background: #B8D6C6; }
.source-paragraph { display: block; margin-bottom: 22rpx; color: #686377; font-size: 25rpx; line-height: 1.85; }
