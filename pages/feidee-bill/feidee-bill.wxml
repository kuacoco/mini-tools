<navigation-bar title="消费账单" />

<view class="bill-page">
	<scroll-view class="bill-scroll" type="custom" scroll-y enhanced bounces="{{ false }}" show-scrollbar="{{ false }}">
		<view class="bill-top-card">
			<view class="range-title">选择日期区间</view>

			<view class="range-row">
				<view class="range-item">
					<text class="range-label">开始</text>
					<picker mode="date" value="{{ startDate }}" bindchange="onStartDateChange">
						<view class="range-value">{{ startDate }}</view>
					</picker>
				</view>
				<view class="range-sep">至</view>
				<view class="range-item">
					<text class="range-label">结束</text>
					<picker mode="date" value="{{ endDate }}" bindchange="onEndDateChange">
						<view class="range-value">{{ endDate }}</view>
					</picker>
				</view>
			</view>

			<view class="quick-seg" role="tablist" aria-label="快捷选择">
				<view class="quick-seg-item {{ quickType === 'today' ? 'active' : '' }}" bindtap="onQuickToday" role="tab" aria-selected="{{ quickType === 'today' }}">
					当天
				</view>
				<view class="quick-seg-item {{ quickType === 'month' ? 'active' : '' }}" bindtap="onQuickMonth" role="tab" aria-selected="{{ quickType === 'month' }}">
					当月
				</view>
			</view>

			<view class="total-row">
				<text class="total-label">总额</text>
				<text class="total-value">¥{{ totalAmountText }}</text>
			</view>
		</view>

		<view class="bill-list">
			<view class="bill-body-card">
				<view wx:if="{{ isLoading }}" class="card-placeholder">
					<text class="placeholder-text">加载中...</text>
				</view>

				<view wx:else>
					<view wx:if="{{ !sections.length }}" class="empty-card">
						<text class="empty-title">该区间暂无消费记录</text>
						<text class="empty-desc">可尝试调整日期区间</text>
					</view>

					<view wx:else class="bill-sheet">
						<view wx:for="{{ sections }}" wx:key="key" class="sheet-group">
							<view class="sheet-cat" data-key="{{ item.key }}" bindtap="onToggleCategory">
								<view class="sheet-cat-icon" style="background-color: {{ item.catIconBg }}">
									<text class="sheet-cat-icon-text">{{ item.catInitial }}</text>
								</view>
								<view class="sheet-cat-mid">
									<text class="sheet-cat-name">{{ item.name }}</text>
									<text class="sheet-cat-count">({{ item.count }})</text>
								</view>
								<view class="sheet-cat-right">
									<text class="sheet-cat-total">¥{{ item.totalText }}</text>
									<text class="sheet-cat-arrow {{ item.collapsed ? 'collapsed' : '' }}">›</text>
								</view>
							</view>

							<view wx:if="{{ !item.collapsed }}" class="sheet-rows">
								<view wx:for="{{ item.items }}" wx:for-item="tx" wx:key="id" class="sheet-row">
									<text class="sheet-remark">{{ tx.remark || '无备注' }}</text>
									<text class="sheet-amt">{{ tx.amountText }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</view>
