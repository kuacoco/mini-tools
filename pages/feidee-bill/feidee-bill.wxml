<navigation-bar title="消费账单" />

<view class="bill-page">
	<scroll-view class="bill-scroll" type="custom" scroll-y enhanced bounces="{{ false }}" show-scrollbar="{{ false }}">
		<view class="bill-head">
			<picker mode="date" fields="month" value="{{ monthValue }}" bindchange="onMonthChange">
				<view class="month-picker-trigger">
					<text class="month-picker-label">账单月份</text>
					<view class="month-picker-value-row">
						<text class="month-picker-value">{{ monthLabel }}</text>
						<text class="month-picker-arrow">⌄</text>
					</view>
				</view>
			</picker>
			<view class="total-stamp">
				<text class="total-stamp-label">本月支出</text>
				<text class="total-stamp-value">¥{{ totalAmountText }}</text>
			</view>
		</view>

		<view class="ledger-caption">
			<text class="ledger-title">消费账单</text>
			<text class="ledger-subtitle">按消费分类整理</text>
		</view>

		<!-- 分类过滤标签 -->
		<view wx:if="{{ categoryFilter && categoryName }}" class="filter-tag-shell">
			<view class="filter-tag">
				<text class="filter-tag-name">{{ categoryName }}</text>
				<view class="filter-tag-close" bindtap="onClearCategoryFilter" aria-label="清除分类筛选">✕</view>
			</view>
		</view>

		<block wx:if="{{ isLoading }}">
			<view class="bill-list">
				<view class="bill-body-card">
					<view class="card-placeholder">
						<text class="placeholder-text">正在整理本月消费...</text>
					</view>
				</view>
			</view>
		</block>

		<block wx:elif="{{ categoryFilter && rawTransactions }}">
			<!-- 分类过滤模式：直接显示交易列表 -->
			<view wx:if="{{ rawTransactions.length }}" class="sheet-rows-shell">
				<view class="sheet-rows">
					<view wx:for="{{ rawTransactions }}" wx:key="id" class="sheet-row">
						<view class="row-left">
							<text class="sheet-date">{{ item.dateText }}</text>
							<text class="sheet-remark">{{ item.remark || '无备注' }}</text>
						</view>
						<text class="sheet-amt">{{ item.amountText }}</text>
					</view>
				</view>
			</view>
			<view wx:else class="bill-list">
				<view class="bill-body-card">
					<view class="empty-card">
						<text class="empty-title">该分类本月暂无消费记录</text>
						<text class="empty-desc">切换月份可查看其他账单</text>
					</view>
				</view>
			</view>
			<view class="bill-list-bottom-space" />
		</block>

		<block wx:elif="{{ !sections.length }}">
			<view class="bill-list">
				<view class="bill-body-card">
					<view class="empty-card">
						<text class="empty-title">本月暂无消费记录</text>
						<text class="empty-desc">切换月份可查看其他账单</text>
					</view>
				</view>
			</view>
		</block>

		<block wx:else>
			<sticky-section wx:for="{{ sections }}" wx:key="key" wx:for-item="section" wx:for-index="sectionIndex">
				<sticky-header>
					<view class="sheet-cat-shell {{ section.collapsed ? 'collapsed' : '' }}">
						<view class="sheet-cat" hover-class="sheet-cat--active" hover-stay-time="80" data-key="{{ section.key }}" bindtap="onToggleCategory">
							<view class="sheet-cat-icon" style="background-color: {{ section.catIconBg }}">
								<text class="sheet-cat-icon-text">{{ section.catInitial }}</text>
							</view>
							<view class="sheet-cat-mid">
								<text class="sheet-cat-name">{{ section.name }}</text>
								<text class="sheet-cat-count">({{ section.count }})</text>
							</view>
							<view class="sheet-cat-right">
								<text class="sheet-cat-total">¥{{ section.totalText }}</text>
								<text class="sheet-cat-arrow {{ section.collapsed ? 'collapsed' : '' }}">›</text>
							</view>
						</view>
					</view>
				</sticky-header>

				<list-view wx:if="{{ !section.collapsed }}">
					<view class="sheet-rows-shell">
						<view class="sheet-rows">
							<view wx:for="{{ section.items }}" wx:for-item="tx" wx:key="id" class="sheet-row">
								<view class="row-left">
									<text class="sheet-date">{{ tx.dateText }}</text>
									<text class="sheet-remark">{{ tx.remark || '无备注' }}</text>
								</view>
								<text class="sheet-amt">{{ tx.amountText }}</text>
							</view>
						</view>
					</view>
				</list-view>

				<view wx:if="{{ sectionIndex !== sections.length - 1 }}" class="sheet-group-gap" />
			</sticky-section>

			<view class="bill-list-bottom-space" />
		</block>
	</scroll-view>
</view>
