page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.bill-page {
  flex: 1;
  min-height: 0;
  background: #fff9f0;
}

.bill-scroll {
  height: 100%;
  min-height: 0;
}

.bill-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 26rpx 24rpx 0;
}

.month-picker-trigger {
  display: inline-flex;
  flex-direction: column;
  padding: 12rpx 0 10rpx;
}

.month-picker-label {
  display: block;
  color: #8d8171;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.month-picker-value-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.month-picker-value {
  color: #2f3152;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.month-picker-arrow {
  margin-left: 10rpx;
  color: #e86e4f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.total-stamp {
  min-width: 180rpx;
  margin-top: 2rpx;
  padding: 16rpx 18rpx 14rpx;
  box-sizing: border-box;
  border: 2rpx solid #f0cfc1;
  border-radius: 18rpx;
  background: #fff2e9;
  text-align: right;
}

.total-stamp-label,
.total-stamp-value {
  display: block;
}

.total-stamp-label {
  color: #a46958;
  font-size: 20rpx;
  line-height: 1.2;
}

.total-stamp-value {
  margin-top: 6rpx;
  color: #c6573d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
}

.ledger-caption {
  display: flex;
  align-items: baseline;
  margin: 34rpx 24rpx 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #eadbc8;
}

.ledger-title {
  color: #2f3152;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ledger-subtitle {
  margin-left: 16rpx;
  color: #a39482;
  font-size: 22rpx;
  line-height: 1.4;
}

.filter-tag-shell {
  margin: -2rpx 24rpx 20rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 14rpx 12rpx 18rpx;
  border: 2rpx solid #e8d8c7;
  border-radius: 999rpx;
  background: #fffdf9;
}

.filter-tag-name {
  color: #5e5a75;
  font-size: 23rpx;
  font-weight: 600;
}

.filter-tag-close {
  width: 34rpx;
  height: 34rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4e9dd;
  color: #927c6a;
  font-size: 20rpx;
  line-height: 1;
}

.bill-list {
  padding: 0 24rpx 120rpx;
  box-sizing: border-box;
}

.bill-body-card {
  border: 2rpx solid #eadbc8;
  border-radius: 24rpx;
  background: #fffdf9;
}

.card-placeholder,
.empty-card {
  padding: 54rpx 28rpx;
  text-align: center;
}

.placeholder-text {
  color: #8b7f73;
  font-size: 25rpx;
}

.empty-title {
  display: block;
  color: #45455d;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  color: #9f9183;
  font-size: 22rpx;
}

.sheet-cat-shell,
.sheet-rows-shell {
  margin: 0 24rpx;
  box-sizing: border-box;
}

.sheet-cat-shell {
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  background: #2f3152;
}

.sheet-cat-shell.collapsed {
  border-radius: 24rpx;
}

.sheet-cat {
  display: flex;
  align-items: center;
  padding: 24rpx;
  box-sizing: border-box;
  background: #2f3152;
  transition: opacity 120ms ease;
}

.sheet-cat--active {
  opacity: 0.82;
}

.sheet-cat > view + view {
  margin-left: 12rpx;
}

.sheet-cat-icon {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-cat-icon-text {
  color: #2f3152;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.sheet-cat-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.sheet-cat-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
}

.sheet-cat-count {
  flex: none;
  margin-left: 8rpx;
  color: #c3c5dd;
  font-size: 20rpx;
}

.sheet-cat-right {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 16rpx;
}

.sheet-cat-total {
  color: #fff0c7;
  font-size: 28rpx;
  font-weight: 700;
}

.sheet-cat-arrow {
  margin-left: 12rpx;
  color: #c3c5dd;
  font-size: 24rpx;
  transform: rotate(90deg);
  transform-origin: center;
  transition: transform 120ms ease;
}

.sheet-cat-arrow.collapsed {
  transform: rotate(0deg);
}

.sheet-rows-shell {
  border-right: 2rpx solid #eadbc8;
  border-bottom: 2rpx solid #eadbc8;
  border-left: 2rpx solid #eadbc8;
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
  background: #fffdf9;
}

.sheet-rows {
  padding: 4rpx 20rpx 8rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #f2e8dc;
  box-sizing: border-box;
}

.sheet-rows .sheet-row:last-child {
  border-bottom: none;
}

.row-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.sheet-date {
  flex: none;
  margin-right: 14rpx;
  color: #aa9e93;
  font-size: 20rpx;
}

.sheet-remark {
  flex: 1;
  min-width: 0;
  color: #45455d;
  font-size: 25rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-amt {
  flex: none;
  margin-left: 18rpx;
  color: #c6573d;
  font-size: 27rpx;
  font-weight: 700;
}

.sheet-group-gap {
  height: 18rpx;
}

.bill-list-bottom-space {
  height: 120rpx;
}
