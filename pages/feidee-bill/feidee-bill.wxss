page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.bill-page {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #f7f5ff 0%, #f8f9fd 46%, #f3f5fa 100%);
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  opacity: 0.44;
  pointer-events: none;
}

.page-glow--left {
  top: -220rpx;
  left: -230rpx;
  background: radial-gradient(circle, rgba(202, 187, 255, 0.74), rgba(202, 187, 255, 0));
}

.page-glow--right {
  top: 460rpx;
  right: -250rpx;
  background: radial-gradient(circle, rgba(255, 193, 213, 0.58), rgba(255, 193, 213, 0));
}

.bill-scroll {
  position: relative;
  z-index: 1;
  height: 100%;
  min-height: 0;
}

.summary-card {
  position: relative;
  overflow: hidden;
  margin: 22rpx 24rpx 18rpx;
  padding: 24rpx 26rpx 25rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff, #f8f5ff);
  box-shadow: 0 18rpx 52rpx rgba(77, 62, 132, 0.12);
}

.summary-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.summary-decoration--one {
  top: -96rpx;
  right: -56rpx;
  width: 260rpx;
  height: 260rpx;
  background: linear-gradient(135deg, rgba(175, 151, 244, 0.2), rgba(239, 178, 206, 0.08));
}

.summary-decoration--two {
  right: 80rpx;
  bottom: -126rpx;
  width: 190rpx;
  height: 190rpx;
  border: 32rpx solid rgba(121, 105, 187, 0.045);
  box-sizing: border-box;
}

.summary-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-kicker {
  color: #8f82bf;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.month-shortcuts {
  display: flex;
  align-items: center;
}

.month-shortcut-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 11rpx 12rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.1);
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 5rpx 13rpx rgba(69, 57, 108, 0.06);
  box-sizing: border-box;
}

.month-shortcut-btn + .month-shortcut-btn { margin-left: 9rpx; }

.month-shortcut-text {
  margin: 0 5rpx;
  color: #6b6192;
  font-size: 20rpx;
  font-weight: 650;
}

.month-shortcut-arrow {
  display: block;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
}

.summary-amount {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 17rpx;
  flex-direction: column;
}

.summary-label {
  color: #9696a9;
  font-size: 22rpx;
}

.summary-value {
  margin-top: 5rpx;
  color: #303148;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.16;
  font-variant-numeric: tabular-nums;
}

.summary-symbol {
  margin-right: 5rpx;
  color: #5f547f;
  font-size: 36rpx;
  font-weight: 700;
}

.summary-footer {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(109, 94, 162, 0.08);
}

.summary-footer-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #8373bd;
  box-shadow: 0 0 0 6rpx rgba(131, 115, 189, 0.1);
}

.summary-footer-text {
  color: #9291a3;
  font-size: 21rpx;
}

.filter-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 18rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(68, 55, 108, 0.075);
}

.filter-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #7868b6, #9985d3);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.filter-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  flex-direction: column;
}

.filter-label {
  color: #aaa7b5;
  font-size: 18rpx;
}

.filter-name {
  overflow: hidden;
  margin-top: 3rpx;
  color: #4b4c62;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-clear {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 14rpx;
  padding: 10rpx 13rpx;
  border-radius: 999rpx;
  background: #f2eff9;
}

.filter-clear-text {
  color: #786aad;
  font-size: 20rpx;
  font-weight: 600;
}

.filter-clear-icon {
  display: block;
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
}

.list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 5rpx 32rpx 20rpx;
}

.list-heading-copy {
  display: flex;
  flex-direction: column;
}

.list-kicker {
  margin-bottom: 5rpx;
  color: #9588c4;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.5rpx;
}

.list-title {
  color: #38394f;
  font-size: 33rpx;
  font-weight: 750;
}

.list-count {
  display: flex;
  align-items: baseline;
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(113, 96, 174, 0.09);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.list-count-value {
  color: #675ba6;
  font-size: 25rpx;
  font-weight: 750;
}

.list-count-unit {
  margin-left: 5rpx;
  color: #9896a8;
  font-size: 19rpx;
}

.bill-list {
  padding: 0 24rpx 120rpx;
  box-sizing: border-box;
}

.bill-body-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 176rpx;
  padding: 34rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(68, 55, 108, 0.08);
  box-sizing: border-box;
  flex-direction: column;
  text-align: center;
}

.loading-mark {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 15rpx;
  border: 5rpx solid #e6e0f3;
  border-top-color: #8473be;
  border-radius: 50%;
}

.placeholder-text {
  color: #858598;
  font-size: 24rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 17rpx;
  border-radius: 22rpx;
  background: #f1edf9;
  color: #7b6caf;
  font-size: 27rpx;
  font-weight: 750;
}

.empty-title {
  color: #505166;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 9rpx;
  color: #9c9bac;
  font-size: 22rpx;
}

.bill-group,
.transaction-card {
  margin: 0 24rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(68, 55, 108, 0.085);
}

.sheet-cat {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 22rpx;
  border-bottom: 1rpx solid rgba(104, 89, 159, 0.07);
  background: linear-gradient(135deg, #fff, #faf8ff);
  box-sizing: border-box;
  transition: opacity 120ms ease;
}

.sheet-cat--active { opacity: 0.8; }

.sheet-cat-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 23rpx;
  box-shadow: 0 8rpx 17rpx rgba(57, 48, 91, 0.1);
  box-sizing: border-box;
}

.sheet-cat-icon-text {
  color: #4e4f65;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1;
}

.sheet-cat-mid {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  flex-direction: column;
}

.sheet-cat-name {
  overflow: hidden;
  color: #38394f;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-cat-count {
  margin-top: 7rpx;
  color: #9b99aa;
  font-size: 20rpx;
}

.sheet-cat-right {
  display: flex;
  flex: none;
  align-items: center;
  margin-left: 16rpx;
}

.sheet-cat-total {
  color: #45465c;
  font-size: 29rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.sheet-cat-arrow-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-left: 11rpx;
  border-radius: 14rpx;
  background: #f1eef9;
}

.sheet-cat-arrow {
  color: #8274b4;
  font-size: 27rpx;
  line-height: 1;
  transform: rotate(90deg);
  transform-origin: center;
  transition: transform 150ms ease;
}

.sheet-cat-arrow.collapsed { transform: rotate(0deg); }

.sheet-rows-shell {
  overflow: hidden;
  background: #fff;
}

.sheet-rows { padding: 7rpx 20rpx 10rpx; }
.sheet-rows .sheet-row:last-child { border-bottom: none; }

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(71, 72, 95, 0.055);
  box-sizing: border-box;
}

.transaction-date-badge {
  flex: none;
  min-width: 116rpx;
  margin-right: 15rpx;
  padding: 9rpx 10rpx;
  border-radius: 14rpx;
  background: #f3f0fa;
  color: #776ca2;
  font-size: 18rpx;
  font-weight: 650;
  text-align: center;
  box-sizing: border-box;
}

.row-left {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.sheet-remark {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #55566b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-amt {
  flex: none;
  margin-left: 16rpx;
  color: #d5677f;
  font-size: 27rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.bill-list-bottom-space {
  height: calc(112rpx + constant(safe-area-inset-bottom));
  height: calc(112rpx + env(safe-area-inset-bottom));
}
