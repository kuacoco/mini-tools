page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.calendar-page {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(
    180deg,
    #f2fbf7 0%,
    #eef8ff 45%,
    #fff8f2 85%,
    #ffffff 100%
  );
}

.nav-title-trigger {
  display: inline-flex;
  align-items: center;
}

.nav-title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #334155;
}

.nav-title-arrow {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #94a3b8;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}

.nav-title-arrow.is-open {
  transform: rotate(180deg);
}

.calendar-dropdown-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  background: rgba(15, 23, 42, 0.08);
}

.calendar-dropdown-panel {
  margin-top: 184rpx;
  margin-left: auto;
  margin-right: auto;
  width: calc(100% - 88rpx);
  max-width: 620rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 16rpx 44rpx rgba(15, 23, 42, 0.14);
}

.calendar-option {
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.75);
}

.calendar-option:last-child {
  border-bottom: none;
}

.calendar-option-main {
  min-width: 0;
  flex: 1;
  padding-right: 16rpx;
}

.calendar-option-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.calendar-share-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.calendar-share-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.calendar-share-icon--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #0f766e;
  background: rgba(45, 212, 191, 0.18);
  font-weight: 600;
}

.calendar-option-title {
  display: block;
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-option-actions {
  display: flex;
  align-items: center;
}

.calendar-action + .calendar-action {
  margin-left: 12rpx;
}

.calendar-action {
  height: 52rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.calendar-action--icon {
  width: 52rpx;
  padding: 0;
}

.calendar-action--head-icon {
  width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.calendar-action-icon {
  width: 30rpx;
  height: 30rpx;
}

.calendar-action.toggle {
  color: #0f766e;
  background: rgba(45, 212, 191, 0.16);
}

.calendar-action.setting {
  color: #2563eb;
  background: rgba(59, 130, 246, 0.14);
}

.calendar-action.delete {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.14);
}

.calendar-empty {
  padding: 30rpx 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}

.calendar-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.month-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  padding: 24rpx;
  margin-top: 24rpx;
}

.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #334155;
}

.calendar-header {
  display: flex;
  flex-wrap: nowrap;
  margin-bottom: 10rpx;
}

.calendar-weekday {
  flex: 0 0 14.2857143%;
  width: 14.2857143%;
  max-width: 14.2857143%;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
}

.calendar-week-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  width: 100%;
}

.calendar-day {
  flex: 0 0 14.2857143%;
  width: 14.2857143%;
  max-width: 14.2857143%;
  min-height: 126rpx;
  padding: 6rpx 4rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.day-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  font-size: 24rpx;
  color: #64748b;
}

.calendar-day.other-month .day-number {
  color: #cbd5e1;
}

.calendar-day.is-today .day-number {
  width: 54rpx;
  height: 54rpx;
  font-size: 26rpx;
  background: linear-gradient(145deg, #34d399 0%, #14b8a6 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(20, 184, 166, 0.35);
}

.calendar-day.is-selected .day-number {
  width: 54rpx;
  height: 54rpx;
  font-size: 26rpx;
  background: rgba(204, 251, 241, 0.95);
  color: #14b8a6;
  box-shadow: 0 4rpx 12rpx rgba(20, 184, 166, 0.35);
  font-weight: 600;
}

.calendar-day.is-selected.is-today .day-number {
  width: 54rpx;
  height: 54rpx;
  font-size: 26rpx;
  background: linear-gradient(145deg, #34d399 0%, #14b8a6 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(20, 184, 166, 0.35);
}

.day-events {
  width: 100%;
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
}

.day-events .event-pill + .event-pill {
  margin-top: 4rpx;
}

.day-events .event-more {
  margin-top: 4rpx;
}

.event-pill {
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
  padding: 0 8rpx;
  color: #fff;
}

.event-pill-content {
  display: flex;
  align-items: center;
}

.event-pill-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.event-pill-icon--text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12rpx;
  font-weight: 600;
  color: #0f766e;
  background: rgba(255, 255, 255, 0.95);
}

.event-pill-text {
  display: block;
  font-size: 18rpx;
  overflow: hidden;
  white-space: nowrap;
}

.event-more {
  font-size: 20rpx;
  color: #64748b;
  line-height: 24rpx;
  padding-left: 4rpx;
}

.fab-left,
.fab-right {
  position: fixed;
  bottom: 46rpx;
  z-index: 998;
}

.fab-left {
  left: 30rpx;
}

.fab-right {
  right: 30rpx;
}

.today-btn {
  min-width: 98rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  padding: 0 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f766e;
  background: rgba(204, 251, 241, 0.95);
  box-shadow: 0 8rpx 28rpx rgba(15, 118, 110, 0.2);
}

.add-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #4ade80 0%, #2dd4bf 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(45, 212, 191, 0.45);
}

.add-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1300;
  background: rgba(15, 23, 42, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.popup-sheet {
  width: 100%;
  max-width: 650rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f0fdf9 100%);
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 20rpx 64rpx rgba(15, 23, 42, 0.2);
  overflow: hidden;
}

.popup-sheet-center {
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.popup-sheet-day {
  max-height: 86vh;
  position: relative;
}

.popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.95);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
}

.popup-close {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(241, 245, 249, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-close-icon {
  width: 34rpx;
  height: 34rpx;
}

.popup-body {
  padding: 20rpx 26rpx;
}

.day-popup-body {
  flex: 1;
  min-height: 360rpx;
  height: 700rpx;
  max-height: 70vh;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.popup-field {
  margin-bottom: 24rpx;
}

.popup-field:last-child {
  margin-bottom: 0;
}

.popup-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 14rpx;
}

.popup-input {
  width: 100%;
  height: 78rpx;
  border-radius: 16rpx;
  border: 2rpx solid #cbd5e1;
  background: #fff;
  padding: 0 18rpx;
  font-size: 30rpx;
  color: #334155;
  box-sizing: border-box;
}

.date-range-row {
  display: flex;
  align-items: center;
}

.date-picker {
  flex: 1;
}

.date-picker-btn {
  min-width: 212rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx solid #cbd5e1;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #334155;
  box-sizing: border-box;
  text-align: center;
}

.date-range-sep {
  font-size: 28rpx;
  color: #94a3b8;
  margin: 0 10rpx;
}

.palette-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -20rpx;
  margin-bottom: -16rpx;
  justify-content: center;
}

.palette-item {
  width: 46rpx;
  height: 46rpx;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  /* border: 2rpx solid rgba(255, 255, 255, 0.9); */
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.12);
}

.palette-item.active {
  transform: scale(1.14);
  /* border: 2rpx solid #0f766e; */
  box-shadow:
    0 10rpx 22rpx rgba(15, 118, 110, 0.34),
    0 3rpx 10rpx rgba(15, 23, 42, 0.24);
}

.popup-footer {
  padding: 22rpx 26rpx 26rpx;
}

.popup-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.popup-btn.primary {
  color: #fff;
  background: linear-gradient(145deg, #4ade80 0%, #2dd4bf 100%);
  box-shadow: 0 10rpx 28rpx rgba(45, 212, 191, 0.35);
}

.popup-btn--day {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.popup-btn.disabled {
  opacity: 0.7;
}

.popup-empty {
  padding: 42rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.day-popup-title-wrap {
  display: inline-flex;
  align-items: center;
}

.day-popup-head-add {
  margin-left: 16rpx;
  min-width: 86rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
  background: rgba(45, 212, 191, 0.16);
}

.day-event-swipe-rows {
  overflow: hidden;
  padding-top: 26rpx;
  padding-bottom: 8rpx;
}

.day-event-swipe-row {
  position: relative;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.day-event-swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #8fb6f9 0%, #7fcad1 100%);
  display: flex;
  align-items: stretch;
}

.day-event-swipe-actions::before {
  content: "";
  position: absolute;
  left: -20rpx;
  top: 0;
  bottom: 0;
  width: 20rpx;
  background: #fff;
}

.day-event-swipe-action {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-event-action-icon {
  width: 30rpx;
  height: 30rpx;
}

.day-event-action-icon--edit {
  width: 58rpx;
  height: 30rpx;
}

.day-event-swipe-action.edit {
  background: linear-gradient(135deg, #8fb6f9 0%, #7fcad1 100%);
}

.day-event-swipe-action.delete {
  background: linear-gradient(135deg, #f4a7b9 0%, #d06d7f 100%);
}

.day-event-row {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  transition: transform 0.18s ease;
}

.day-event-indicator {
  width: 10rpx;
  border-radius: 10rpx 0 0 10rpx;
  flex-shrink: 0;
}

.day-event-main {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx 18rpx;
}

.day-event-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 14rpx;
}

.day-event-title {
  display: inline-block;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.day-event-range {
  display: inline-block;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #64748b;
}

.day-event-owner-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.day-event-owner-prefix {
  font-size: 22rpx;
  color: #94a3b8;
}

.day-event-owner-icon {
  width: 24rpx;
  height: 24rpx;
  margin: 0 8rpx 0 4rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.day-event-owner-icon--text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(45, 212, 191, 0.16);
  color: #0f766e;
  font-size: 14rpx;
  font-weight: 600;
}

.day-event-owner-name {
  display: inline-block;
  max-width: 360rpx;
  font-size: 22rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-name-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1400;
  background: rgba(15, 23, 42, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
}

.share-name-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 20rpx 56rpx rgba(15, 23, 42, 0.2);
}

.share-name-title {
  display: block;
  font-size: 32rpx;
  color: #334155;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.share-name-hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.share-name-input {
  width: 100%;
  height: 90rpx;
  border-radius: 16rpx;
  border: 2rpx solid #cbd5e1;
  background: #fff;
  padding: 0 18rpx;
  font-size: 30rpx;
  color: #334155;
  box-sizing: border-box;
}

.share-name-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.share-icon-editor {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.share-avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: transparent;
  color: inherit;
  border: none;
  padding: 0;
}

.share-avatar-btn::after {
  border: none;
}

.share-avatar-btn-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 400;
}

.share-icon-preview {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(45, 212, 191, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.share-icon-preview-image {
  width: 100%;
  height: 100%;
}

.share-icon-preview-text {
  font-size: 42rpx;
  color: #0f766e;
  font-weight: 600;
}

.share-name-btn + .share-name-btn {
  margin-left: 16rpx;
}

.share-name-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 41rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.share-name-btn--ghost {
  background: #f1f5f9;
  color: #64748b;
}

.share-name-btn--primary {
  background: linear-gradient(145deg, #4ade80 0%, #2dd4bf 100%);
  color: #fff;
}

.popup-mask.is-entering {
  animation: maskFadeIn 180ms ease-out forwards;
}

.popup-mask.is-entering .popup-sheet {
  animation: dialogIn 220ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.popup-mask.is-leaving {
  animation: maskFadeOut 180ms ease-out forwards;
}

.popup-mask.is-leaving .popup-sheet {
  animation: dialogOut 200ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes maskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes maskFadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes dialogIn {
  from {
    opacity: 0;
    transform: translateY(36rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes dialogOut {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(26rpx) scale(0.98);
  }
}

/* ---------- 统一视觉主题 ---------- */
.calendar-page {
  overflow: hidden;
  background: linear-gradient(180deg, #f7f5ff 0%, #f8f9fd 46%, #f3f5fa 100%);
}

.page-glow {
  position: absolute;
  z-index: 0;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  opacity: 0.44;
  pointer-events: none;
}

.page-glow--left {
  top: -230rpx;
  left: -230rpx;
  background: radial-gradient(circle, rgba(202, 187, 255, 0.74), rgba(202, 187, 255, 0));
}

.page-glow--right {
  top: 600rpx;
  right: -260rpx;
  background: radial-gradient(circle, rgba(255, 193, 213, 0.58), rgba(255, 193, 213, 0));
}

.nav-title-text {
